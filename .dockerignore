# Keep the build context to the harness itself. The baseline snapshots and the
# results directory are bind-mounted by `make docker-run` (subjects/ read-only,
# results/ read-write), so copying them into the image is wasted work and would
# let a stale host copy shadow the mount. The host virtualenv must never enter
# the image: the container installs its own from requirements-analysis.txt.
.venv/
.git/
.pytest_cache/
__pycache__/
*.pyc
subjects/*/
!subjects/subjects.json
results/

# Generation-side working state: the two agent virtualenvs, the SWE-agent
# source clone, and the in-flight scratch tree. None is an input to the
# analysis pipeline, and together they are ~500 MB of build context. The frozen
# traces under generation/runs/ ARE copied in: analysis/paper_numbers.py reads
# each run's cost and model-call counts out of them.
generation/.venv-sweagent/
generation/.venv-openhands/
generation/.swe-agent-src/
generation/work/
