print(file_editor(**{'command': 'create', 'path': '/workspace/flask_pair_framework/src/flask_pair_framework/app.py', 'file_text': 'import threading\nfrom jinja2 import Environment, FileSystemLoader\nfrom wsgiref.simple_server import make_server\nfrom .request import Request\nfrom .response import Response\n\nclass FlaskApp:\n    def __init__(self, import_name):\n        self.import_name = import_name\n        self.routes = {}\n        self.jinja_env = Environment(loader=FileSystemLoader(\'templates\'))\n        self.app_context = threading.local()\n\n    def route(self, path, methods=None):\n        if methods is None:\n            methods = [\'GET\']\n\n        def decorator(func):\n            self.routes[(path, tuple(methods))] = func\n            return func\n\n        return decorator\n\n    def wsgi_app(self, environ, start_response):\n        request = Request(environ)\n        response = self.handle_request(request)\n        start_response(response.status, response.headers)\n        return [response.body.encode()]\n\n    def handle_request(self, request):\n        handler = self.routes.get((request.path, tuple([request.method])))\n        if handler is None:\n            return Response(\'Not Found\', status=404)\n        return handler(request)\n\n    def run(self, host=\'127.0.0.1\', port=5000):\n        with make_server(host, port, self) as server:\n            print(f"Running on http://{host}:{port}/ (Press CTRL+C to quit)")\n            server.serve_forever()\n\n    def __call__(self, environ, start_response):\n        return self.wsgi_app(environ, start_response)'}))
