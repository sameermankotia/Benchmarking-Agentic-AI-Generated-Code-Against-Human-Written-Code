            @@ -0,0 +1,60 @@                                                    
            +"""                                                                
            +URL converters for typed path segments.                            
            +"""                                                                
            +                                                                   
            +import re                                                          
            +import uuid                                                        
            +                                                                   
            +                                                                   
            +class Converter:                                                   
            +    """Base converter class."""                                    
            +    regex = '[^/]+'                                                
            +                                                                   
            +    def to_python(self, value):                                    
            +        """Convert URL segment to Python value."""                 
            +        return value                                               
            +                                                                   
            +    def to_url(self, value):                                       
            +        """Convert Python value to URL segment."""                 
            +        return str(value)                                          
            +                                                                   
            +                                                                   
            +class StringConverter(Converter):                                  
            +    """String converter (default)."""                              
            +    regex = '[^/]+'                                                
            +                                                                   
            +                                                                   
            +class IntConverter(Converter):                                     
            +    """Integer converter."""                                       
            +    regex = r'[0-9]+'                                              
            +                                                                   
            +    def to_python(self, value):                                    
            +        return int(value)                                          
            +                                                                   
            +                                                                   
            +class SlugConverter(Converter):                                    
            +    """Slug converter (letters, numbers, hyphens, underscores).""" 
            +    regex = r'[-a-zA-Z0-9_]+'                                      
            +                                                                   
            +                                                                   
            +class UUIDConverter(Converter):                                    
            +    """UUID converter."""                                          
            +    regex =                                                        
            r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'     
            +                                                                   
            +    def to_python(self, value):                                    
            +        return uuid.UUID(value)                                    
            +                                                                   
            +                                                                   
            +class PathConverter(Converter):                                    
            +    """Path converter (includes slashes)."""                       
            +    regex = r'.+'                                                  
            +                                                                   
            +                                                                   
            +# Default converters registry                                      
            +DEFAULT_CONVERTERS = {                                             
            +    'str': StringConverter(),                                      
            +    'int': IntConverter(),                                         
            +    'slug': SlugConverter(),                                       
            +    'uuid': UUIDConverter(),                                       
            +    'path': PathConverter(),                                       
            +}                                                                  
            diff --git a/djangoframework/request.py b/djangoframework/request.py
            new file mode 100644                                                
            index 0000000..697a212                                              
            --- /dev/null                                                       
            +++ b/djangoframework/request.py                                    
            @@ -0,0 +1,67 @@                                                    
            +"""                                                                
            +HTTP request handling for Django-style framework.                  
            +"""                                                                
            +                                                                   
            +import urllib.parse                                                
            +from io import BytesIO                                             
            +                                                                   
            +                                                                   
            +class HttpRequest:                                                 
            +    """                                                            
            +    Encapsulates an HTTP request with method, path, headers, query 
            string, and body.                                                   
            +    """                                                            
            +                                                                   
            +    def __init__(self, environ):                                   
            +        self.environ = environ                                     
            +        self.method = environ['REQUEST_METHOD'].upper()            
            +        self.path = environ['PATH_INFO']                           
            +        self.META = {}                                             
            +                                                                   
            +        # Convert WSGI environ to Django-style META                
            +        for key, value in environ.items():                         
            +            if key.startswith('HTTP_'):                            
            +                # Convert HTTP_HEADER_NAME to Header-Name          
            +                header_name = key[5:].replace('_', '-').title()    
            +                self.META[header_name] = value                     
            +            elif key in ('CONTENT_TYPE', 'CONTENT_LENGTH'):        
            +                self.META[key.replace('_', '-').title()] = value   
            +            else:                                                  
            +                self.META[key] = value                             
            +                                                                   
            +        # Parse query string                                       
            +        self.GET = {}                                              
            +        query_string = environ.get('QUERY_STRING', '')             
            +        if query_string:                                           
            +            parsed = urllib.parse.parse_qs(query_string,           
            keep_blank_values=True)                                             
            +            for key, values in parsed.items():                     
            +                # Django typically returns the last value for      
            duplicate keys                                                      
            +                self.GET[key] = values[-1] if values else ''       
            +                                                                   
            +        # Handle request body                                      
            +        self._body = None                                          
            +        self.content_length = int(environ.get('CONTENT_LENGTH', 0) 
            or 0)                                                               
            +                                                                   
            +        # URL resolver will set these                              
            +        self.resolver_match = None                                 
            +        self.url_kwargs = {}                                       
            +                                                                   
            +    @property                                                      
            +    def body(self):                                                
            +        """Get the request body as bytes."""                       
            +        if self._body is None:                                     
            +            if self.content_length > 0:                            
            +                wsgi_input = self.environ.get('wsgi.input')        
            +                if wsgi_input:                                     
            +                    self._body =                                   
            wsgi_input.read(self.content_length)                                
            +                else:                                              
            +                    self._body = b''                               
            +            else:                                                  
            +                self._body = b''                                   
            +        return self._body                                          
            +                                                                   
            +    def get_full_path(self):                                       
            +        """Return the full path including query string."""         
            +        query_string = self.environ.get('QUERY_STRING', '')        
            +        if query_string:                                           
            +            return f"{self.path}?{query_string}"                   
            +        return self.path                                           
            diff --git a/djangoframework/response.py                            
            b/djangoframework/response.py                                       
            new file mode 100644                                                
            index 0000000..73faa4b                                              
            --- /dev/null                                                       
            +++ b/djangoframework/response.py                                   
            @@ -0,0 +1,70 @@                                                    
            +"""                                                                
            +HTTP response handling for Django-style framework.                 
            +"""                                                                
            +                                                                   
            +                                                                   
            +class HttpResponse:                                                
            +    """                                                            
            +    HTTP response object carrying status code, headers, and body.  
            +    """                                                            
            +                                                                   
            +    def __init__(self, content='', content_type='text/html;        
            charset=utf-8', status=200):                                        
            +        self.content = content                                     
            +        self.status_code = status                                  
            +        self._headers = {}                                         
            +                                                                   
            +        # Set default content type                                 
            +        self['Content-Type'] = content_type                        
            +                                                                   
            +    def __setitem__(self, header, value):                          
            +        """Set a header value."""                                  
            +        self._headers[header.lower()] = (header, str(value))       
            +                                                                   
            +    def __getitem__(self, header):                                 
            +        """Get a header value."""                                  
            +        return self._headers[header.lower()][1]                    
            +                                                                   
            +    def __delitem__(self, header):                                 
            +        """Delete a header."""                                     
            +        del self._headers[header.lower()]                          
            +                                                                   
            +    def __contains__(self, header):                                
            +        """Check if header exists."""                              
            +        return header.lower() in self._headers                     
            +                                                                   
            +    def get(self, header, default=None):                           
            +        """Get a header value with default."""                     
            +        try:                                                       
            +            return self[header]                                    
            +        except KeyError:                                           
            +            return default                                         
            +                                                                   
            +    def items(self):                                               
            +        """Return header items as (name, value) tuples."""         
            +        return [item for item in self._headers.values()]           
            +                                                                   
            +    @property                                                      
            +    def content_bytes(self):                                       
            +        """Get content as bytes."""                                
            +        if isinstance(self.content, str):                          
            +            return self.content.encode('utf-8')                    
            +        return self.content                                        
            +                                                                   
            +    def __iter__(self):                                            
            +        """Make response iterable for WSGI."""                     
            +        yield self.content_bytes                                   
            +                                                                   
            +                                                                   
            +class HttpResponseNotFound(HttpResponse):                          
            +    """404 Not Found response."""                                  
            +                                                                   
            +    def __init__(self, content='Not Found', *args, **kwargs):      
            +        super().__init__(content, status=404, *args, **kwargs)     
            +                                                                   
            +                                                                   
            +class HttpResponseNotAllowed(HttpResponse):                        
            +    """405 Method Not Allowed response."""                         
            +                                                                   
            +    def __init__(self, permitted_methods, content='Method Not      
            Allowed', *args, **kwargs):                                         
            +        super().__init__(content, status=405, *args, **kwargs)     
            +        self['Allow'] = ', '.join(permitted_methods)               
            diff --git a/djangoframework/urls.py b/djangoframework/urls.py      
            new file mode 100644                                                
            index 0000000..3aef7bf                                              
            --- /dev/null                                                       
            +++ b/djangoframework/urls.py                                       
            @@ -0,0 +1,154 @@                                                   
            +"""                                                                
            +URL routing and pattern matching for Django-style framework.       
            +"""                                                                
            +                                                                   
            +import re                                                          
            +from .converters import DEFAULT_CONVERTERS                         
            +from .response import HttpResponseNotFound                         
            +                                                                   
            +                                                                   
            +class ResolverMatch:                                               
            +    """Represents a successful URL resolution."""                  
            +                                                                   
            +    def __init__(self, func, args, kwargs, url_name=None,          
            app_names=None, namespaces=None):                                   
            +        self.func = func                                           
            +        self.args = args                                           
            +        self.kwargs = kwargs                                       
            +        self.url_name = url_name                                   
            +        self.app_names = app_names or []                           
            +        self.namespaces = namespaces or []                         
            +                                                                   
            +                                                                   
            +class URLPattern:                                                  
            +    """A single URL pattern."""                                    
            +                                                                   
            +    def __init__(self, pattern, callback, kwargs=None, name=None): 
            +        self.pattern = pattern                                     
            +        self.callback = callback                                   
            +        self.default_kwargs = kwargs or {}                         
            +        self.name = name                                           
            +                                                                   
            +        # Compile the pattern                                      
            +        if hasattr(pattern, 'regex'):                              
            +            # It's already a compiled pattern                      
            +            self.regex = pattern.regex                             
            +            self._converters = getattr(pattern, 'converters', {})  
            +        else:                                                      
            +            # It's a string pattern, compile it                    
            +            self.regex, self._converters =                         
            self._compile_pattern(pattern)                                      
            +                                                                   
            +    def _compile_pattern(self, pattern):                           
            +        """Compile a path pattern with typed converters."""        
            +        converters = {}                                            
            +                                                                   
            +        # Find all <type:name> or <name> segments                  
            +        def replace_converter(match):                              
            +            full_match = match.group(0)                            
            +            converter_type = match.group(1) or 'str'               
            +            name = match.group(2)                                  
            +                                                                   
            +            if converter_type not in DEFAULT_CONVERTERS:           
            +                raise ValueError(f"Unknown converter type:         
            {converter_type}")                                                  
            +                                                                   
            +            converter = DEFAULT_CONVERTERS[converter_type]         
            +            converters[name] = converter                           
            +                                                                   
            +            # Return named group with converter regex              
            +            return f'(?P<{name}>{converter.regex})'                
            +                                                                   
            +        # Pattern for <type:name> or <name>                        
            +        converter_pattern = r'<(?:([^:>]+):)?([^>]+)>'             
            +        regex_pattern = re.sub(converter_pattern,                  
            replace_converter, pattern)                                         
            +                                                                   
            +        # Ensure pattern matches from start to end                 
            +        if not regex_pattern.startswith('^'):                      
            +            regex_pattern = '^' + regex_pattern                    
            +        if not regex_pattern.endswith('$'):                        
            +            regex_pattern = regex_pattern + '$'                    
            +                                                                   
            +        return re.compile(regex_pattern), converters               
            +                                                                   
            +    def resolve(self, path):                                       
            +        """Try to match this pattern against the given path."""    
            +        match = self.regex.match(path)                             
            +        if match:                                                  
            +            kwargs = match.groupdict()                             
            +                                                                   
            +            # Convert matched values using converters              
            +            for name, value in kwargs.items():                     
            +                if name in self._converters:                       
            +                    kwargs[name] =                                 
            self._converters[name].to_python(value)                             
            +                                                                   
            +            # Add default kwargs                                   
            +            kwargs.update(self.default_kwargs)                     
            +                                                                   
            +            return ResolverMatch(                                  
            +                func=self.callback,                                
            +                args=(),                                           
            +                kwargs=kwargs,                                     
            +                url_name=self.name                                 
            +            )                                                      
            +        return None                                                
            +                                                                   
            +                                                                   
            +class RegexURLPattern:                                             
            +    """A regex-based URL pattern."""                               
            +                                                                   
            +    def __init__(self, regex, callback, kwargs=None, name=None):   
            +        if isinstance(regex, str):                                 
            +            self.regex = re.compile(regex)                         
            +        else:                                                      
            +            self.regex = regex                                     
            +        self.callback = callback                                   
            +        self.default_kwargs = kwargs or {}                         
            +        self.name = name                                           
            +                                                                   
            +    def resolve(self, path):                                       
            +        """Try to match this pattern against the given path."""    
            +        match = self.regex.match(path)                             
            +        if match:                                                  
            +            kwargs = match.groupdict()                             
            +            args = match.groups()                                  
            +                                                                   
            +            # If we have named groups, use kwargs; otherwise use   
            args                                                                
            +            if kwargs:                                             
            +                kwargs.update(self.default_kwargs)                 
            +                return ResolverMatch(                              
            +                    func=self.callback,                            
            +                    args=(),                                       
            +                    kwargs=kwargs,                                 
            +                    url_name=self.name                             
            +                )                                                  
            +            else:                                                  
            +                return ResolverMatch(                              
            +                    func=self.callback,                            
            +                    args=args,                                     
            +                    kwargs=self.default_kwargs,                    
            +                    url_name=self.name                             
            +                )                                                  
            +        return None                                                
            +                                                                   
            +                                                                   
            +class URLResolver:                                                 
            +    """Resolves URLs against a list of patterns."""                
            +                                                                   
            +    def __init__(self, urlpatterns):                               
            +        self.urlpatterns = urlpatterns                             
            +                                                                   
            +    def resolve(self, path):                                       
            +        """Resolve a path against the URL patterns."""             
            +        for pattern in self.urlpatterns:                           
            +            match = pattern.resolve(path)                          
            +            if match:                                              
            +                return match                                       
            +        return None                                                
            +                                                                   
            +                                                                   
            +def path(route, view, kwargs=None, name=None):                     
            +    """Create a URL pattern with typed path converters."""         
            +    return URLPattern(route, view, kwargs, name)                   
            +                                                                   
            +                                                                   
            +def re_path(regex, view, kwargs=None, name=None):                  
            +    """Create a regex-based URL pattern."""                        
            +    return RegexURLPattern(regex, view, kwargs, name)              
            diff --git a/djangoframework/views.py b/djangoframework/views.py    
            new file mode 100644                                                
            index 0000000..217b73e                                              
            --- /dev/null                                                       
            +++ b/djangoframework/views.py                                      
            @@ -0,0 +1,87 @@                                                    
            +"""                                                                
            +Class-based views for Django-style framework.                      
            +"""                                                                
            +                                                                   
            +from .response import HttpResponse, HttpResponseNotAllowed         
            +                                                                   
            +                                                                   
            +class View:                                                        
            +    """                                                            
            +    Base class-based view that dispatches requests to methods named
            for HTTP verbs.                                                     
            +    """                                                            
            +                                                                   
            +    http_method_names = ['get', 'post', 'put', 'patch', 'delete',  
            'head', 'options', 'trace']                                         
            +                                                                   
            +    def __init__(self, **kwargs):                                  
            +        """Initialize the view instance."""                        
            +        for key, value in kwargs.items():                          
            +            setattr(self, key, value)                              
            +                                                                   
            +    @classmethod                                                   
            +    def as_view(cls, **initkwargs):                                
            +        """                                                        
            +        Main entry point for a request-response process.           
            +        Returns a view function that can be used in URL patterns.  
            +        """                                                        
            +        def view(request, *args, **kwargs):                        
            +            self = cls(**initkwargs)                               
            +            return self.dispatch(request, *args, **kwargs)         
            +                                                                   
            +        # Copy class attributes to the view function               
            +        view.view_class = cls                                      
            +        view.view_initkwargs = initkwargs                          
            +                                                                   
            +        return view                                                
            +                                                                   
            +    def dispatch(self, request, *args, **kwargs):                  
            +        """                                                        
            +        Dispatch the request to the appropriate handler method.    
            +        """                                                        
            +        # Try to dispatch to the right method; if a method doesn't 
            exist,                                                              
            +        # defer to the error handler. Also defer to the error      
            handler if the                                                      
            +        # request method isn't on the approved list.               
            +        if request.method.lower() in self.http_method_names:       
            +            handler = getattr(self, request.method.lower(),        
            self.http_method_not_allowed)                                       
            +        else:                                                      
            +            handler = self.http_method_not_allowed                 
            +                                                                   
            +        # Handle HEAD requests by using GET handler if available   
            +        if request.method.upper() == 'HEAD' and not hasattr(self,  
            'head'):                                                            
            +            if hasattr(self, 'get'):                               
            +                handler = self.get                                 
            +                                                                   
            +        return handler(request, *args, **kwargs)                   
            +                                                                   
            +    def http_method_not_allowed(self, request, *args, **kwargs):   
            +        """                                                        
            +        Return a 405 Method Not Allowed response with appropriate  
            Allow header.                                                       
            +        """                                                        
            +        allowed_methods = []                                       
            +        for method in self.http_method_names:                      
            +            if hasattr(self, method):                              
            +                allowed_methods.append(method.upper())             
            +                                                                   
            +        # If we have a GET method, HEAD is also allowed            
            +        if 'GET' in allowed_methods and 'HEAD' not in              
            allowed_methods:                                                    
            +            allowed_methods.append('HEAD')                         
            +                                                                   
            +        return HttpResponseNotAllowed(allowed_methods)             
            +                                                                   
            +    def options(self, request, *args, **kwargs):                   
            +        """Handle OPTIONS requests by returning allowed methods."""
            +        allowed_methods = []                                       
            +        for method in self.http_method_names:                      
            +            if hasattr(self, method):                              
            +                allowed_methods.append(method.upper())             
            +                                                                   
            +        # If we have a GET method, HEAD is also allowed            
            +        if 'GET' in allowed_methods and 'HEAD' not in              
            allowed_methods:                                                    
            +            allowed_methods.append('HEAD')                         
            +                                                                   
            +        # Always allow OPTIONS                                     
            +        if 'OPTIONS' not in allowed_methods:                       
            +            allowed_methods.append('OPTIONS')                      
            +                                                                   
            +        response = HttpResponse()                                  
            +        response['Allow'] = ', '.join(sorted(allowed_methods))     
            +        return response                                            
            diff --git a/djangoframework/wsgi.py b/djangoframework/wsgi.py      
            new file mode 100644                                                
            index 0000000..391431d                                              
            --- /dev/null                                                       
            +++ b/djangoframework/wsgi.py                                       
            @@ -0,0 +1,63 @@                                                    
            +"""                                                                
            +WSGI application for Django-style framework.                       
            +"""                                                                
            +                                                                   
            +from .request import HttpRequest                                   
            +from .response import HttpResponseNotFound                         
            +from .urls import URLResolver                                      
            +                                                                   
            +                                                                   
            +class WSGIApplication:                                             
            +    """                                                            
            +    WSGI-compatible application that handles URL routing and view  
            dispatching.                                                        
            +    """                                                            
            +                                                                   
            +    def __init__(self, urlpatterns):                               
            +        self.resolver = URLResolver(urlpatterns)                   
            +                                                                   
            +    def __call__(self, environ, start_response):                   
            +        """                                                        
            +        WSGI application callable.                                 
            +        """                                                        
            +        # Create request object                                    
            +        request = HttpRequest(environ)                             
            +                                                                   
            +        # Try to resolve the URL                                   
            +        resolver_match = self.resolver.resolve(request.path)       
            +                                                                   
            +        if resolver_match is None:                                 
            +            # No pattern matched, return 404                       
            +            response = HttpResponseNotFound()                      
            +        else:                                                      
            +            # Set resolver match on request                        
            +            request.resolver_match = resolver_match                
            +            request.url_kwargs = resolver_match.kwargs             
            +                                                                   
            +            try:                                                   
            +                # Call the view function                           
            +                response = resolver_match.func(request,            
            *resolver_match.args, **resolver_match.kwargs)                      
            +            except Exception as e:                                 
            +                # In a real framework, this would be handled by    
            middleware                                                          
            +                # For now, return a simple 500 error               
            +                from .response import HttpResponse                 
            +                response = HttpResponse(f'Internal Server Error:   
            {str(e)}', status=500)                                              
            +                                                                   
            +        # Prepare WSGI response                                    
            +        status = f'{response.status_code}                          
            {self._get_status_text(response.status_code)}'                      
            +        headers = list(response.items())                           
            +                                                                   
            +        # Start the response                                       
            +        start_response(status, headers)                            
            +                                                                   
            +        # Return response body as iterable                         
            +        return [response.content_bytes]                            
            +                                                                   
            +    def _get_status_text(self, status_code):                       
            +        """Get HTTP status text for status code."""                
            +        status_texts = {                                           
            +            200: 'OK',                                             
            +            404: 'Not Found',                                      
            +            405: 'Method Not Allowed',                             
            +            500: 'Internal Server Error',                          
            +        }                                                          
            +        return status_texts.get(status_code, 'Unknown')            
            diff --git a/example_app.py b/example_app.py                        
            new file mode 100644                                                
            index 0000000..817bd2a                                              
            --- /dev/null                                                       
            +++ b/example_app.py                                                
            @@ -0,0 +1,197 @@                                                   
            +#!/usr/bin/env python3                                             
            +"""                                                                
            +Example application demonstrating the Django-style framework.      
            +"""                                                                
            +                                                                   
            +from djangoframework import WSGIApplication, HttpResponse, View,   
            path, re_path                                                       
            +                                                                   
            +                                                                   
            +# Function-based views                                             
            +def home_view(request):                                            
            +    """Home page view."""                                          
            +    return HttpResponse("""                                        
            +    <html>                                                         
            +        <head><title>Django Framework Demo</title></head>          
            +        <body>                                                     
            +            <h1>Welcome to Django Framework</h1>                   
            +            <p>This is a WSGI-compatible URL routing and view      
            dispatching framework.</p>                                          
            +            <ul>                                                   
            +                <li><a href="/hello/world/">Hello World</a></li>   
            +                <li><a href="/user/123/">User 123</a></li>         
            +                <li><a href="/article/my-article/">Article         
            View</a></li>                                                       
            +                <li><a href="/files/docs/readme.txt/">File         
            View</a></li>                                                       
            +                <li><a href="/api/items/456/">API Item             
            (Class-based)</a></li>                                              
            +                <li><a href="/archive/2023/">Archive 2023</a></li> 
            +            </ul>                                                  
            +        </body>                                                    
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def hello_view(request, name):                                     
            +    """Hello view with name parameter."""                          
            +    return HttpResponse(f"""                                       
            +    <html>                                                         
            +        <head><title>Hello {name}</title></head>                   
            +        <body>                                                     
            +            <h1>Hello, {name}!</h1>                                
            +            <p>Method: {request.method}</p>                        
            +            <p>Path: {request.path}</p>                            
            +            <p><a href="/">Back to home</a></p>                    
            +        </body>                                                    
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def user_view(request, user_id):                                   
            +    """User view with integer ID."""                               
            +    return HttpResponse(f"""                                       
            +    <html>                                                         
            +        <head><title>User {user_id}</title></head>                 
            +        <body>                                                     
            +            <h1>User Profile</h1>                                  
            +            <p>User ID: {user_id} (type:                           
            {type(user_id).__name__})</p>                                       
            +            <p>Method: {request.method}</p>                        
            +            <p><a href="/">Back to home</a></p>                    
            +        </body>                                                    
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def article_view(request, title):                                  
            +    """Article view with slug title."""                            
            +    return HttpResponse(f"""                                       
            +    <html>                                                         
            +        <head><title>Article: {title}</title></head>               
            +        <body>                                                     
            +            <h1>Article: {title}</h1>                              
            +            <p>This is the article page for "{title}"</p>          
            +            <p><a href="/">Back to home</a></p>                    
            +        </body>                                                    
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def file_view(request, filepath):                                  
            +    """File view with path parameter."""                           
            +    return HttpResponse(f"""                                       
            +    <html>                                                         
            +        <head><title>File: {filepath}</title></head>               
            +        <body>                                                     
            +            <h1>File Viewer</h1>                                   
            +            <p>File path: {filepath}</p>                           
            +            <p>This would serve the file: {filepath}</p>           
            +            <p><a href="/">Back to home</a></p>                    
            +        </body>                                                    
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def archive_view(request, year):                                   
            +    """Archive view using regex pattern."""                        
            +    return HttpResponse(f"""                                       
            +    <html>                                                         
            +        <head><title>Archive {year}</title></head>                 
            +        <body>                                                     
            +            <h1>Archive for {year}</h1>                            
            +            <p>This is the archive page for year {year}</p>        
            +            <p><a href="/">Back to home</a></p>                    
            +        </body>                                                    
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +# Class-based view                                                 
            +class APIItemView(View):                                           
            +    """API item view demonstrating class-based views."""           
            +                                                                   
            +    def get(self, request, item_id):                               
            +        """Handle GET requests."""                                 
            +        return HttpResponse(f"""                                   
            +        <html>                                                     
            +            <head><title>API Item {item_id}</title></head>         
            +            <body>                                                 
            +                <h1>API Item {item_id}</h1>                        
            +                <p>GET request received</p>                        
            +                <p>Item ID: {item_id} (type:                       
            {type(item_id).__name__})</p>                                       
            +                <p>Try POST, PUT, or DELETE to see different       
            responses</p>                                                       
            +                <p><a href="/">Back to home</a></p>                
            +            </body>                                                
            +        </html>                                                    
            +        """)                                                       
            +                                                                   
            +    def post(self, request, item_id):                              
            +        """Handle POST requests."""                                
            +        return HttpResponse(f"""                                   
            +        <html>                                                     
            +            <head><title>API Item {item_id} -                      
            Created</title></head>                                              
            +            <body>                                                 
            +                <h1>Item {item_id} Created</h1>                    
            +                <p>POST request received</p>                       
            +                <p><a href="/api/items/{item_id}/">View            
            item</a></p>                                                        
            +                <p><a href="/">Back to home</a></p>                
            +            </body>                                                
            +        </html>                                                    
            +        """)                                                       
            +                                                                   
            +    def put(self, request, item_id):                               
            +        """Handle PUT requests."""                                 
            +        return HttpResponse(f"""                                   
            +        <html>                                                     
            +            <head><title>API Item {item_id} -                      
            Updated</title></head>                                              
            +            <body>                                                 
            +                <h1>Item {item_id} Updated</h1>                    
            +                <p>PUT request received</p>                        
            +                <p><a href="/api/items/{item_id}/">View            
            item</a></p>                                                        
            +                <p><a href="/">Back to home</a></p>                
            +            </body>                                                
            +        </html>                                                    
            +        """)                                                       
            +                                                                   
            +    def delete(self, request, item_id):                            
            +        """Handle DELETE requests."""                              
            +        return HttpResponse(f"""                                   
            +        <html>                                                     
            +            <head><title>API Item {item_id} -                      
            Deleted</title></head>                                              
            +            <body>                                                 
            +                <h1>Item {item_id} Deleted</h1>                    
            +                <p>DELETE request received</p>                     
            +                <p><a href="/">Back to home</a></p>                
            +            </body>                                                
            +        </html>                                                    
            +        """)                                                       
            +                                                                   
            +                                                                   
            +# URL patterns                                                     
            +urlpatterns = [                                                    
            +    # Function-based views with path patterns                      
            +    path('/', home_view),                                          
            +    path('/hello/<str:name>/', hello_view),                        
            +    path('/user/<int:user_id>/', user_view),                       
            +    path('/article/<slug:title>/', article_view),                  
            +    path('/files/<path:filepath>/', file_view),                    
            +                                                                   
            +    # Class-based view                                             
            +    path('/api/items/<int:item_id>/', APIItemView.as_view()),      
            +                                                                   
            +    # Regex pattern                                                
            +    re_path(r'^/archive/(?P<year>[0-9]{4})/$', archive_view),      
            +]                                                                  
            +                                                                   
            +# Create WSGI application                                          
            +application = WSGIApplication(urlpatterns)                         
            +                                                                   
            +                                                                   
            +if __name__ == '__main__':                                         
            +    # Run with Python's built-in WSGI server for development       
            +    from wsgiref.simple_server import make_server                  
            +                                                                   
            +    print("Starting Django Framework demo server...")              
            +    print("Visit http://localhost:8000 to see the demo")           
            +    print("Press Ctrl+C to stop the server")                       
            +                                                                   
            +    server = make_server('localhost', 8000, application)           
            +    try:                                                           
            +        server.serve_forever()                                     
            +    except KeyboardInterrupt:                                      
            +        print("\nServer stopped.")                                 
            diff --git a/pyproject.toml b/pyproject.toml                        
            index ab70d8d..aaf3a9e 100644                                       
            --- a/pyproject.toml                                                
            +++ b/pyproject.toml                                                
            @@ -1,5 +1,44 @@                                                    
