            +                                                                   
            +def test_literal_paths():                                          
            +    """Test literal path matching."""                              
            +    print("Testing literal paths...")                              
            +                                                                   
            +    def home_view(request):                                        
            +        return HttpResponse("Home")                                
            +                                                                   
            +    def about_view(request):                                       
            +        return HttpResponse("About")                               
