            +"""                                                                
            +HTTP request and response objects.                                 
            +"""                                                                
            +                                                                   
            +import urllib.parse                                                
            +from io import BytesIO                                             
            +                                                                   
            +                                                                   
            +class HttpRequest:                                                 
            +    """                                                            
            +    Encapsulates HTTP request data including method, path, headers,
            query string, and body.                                             
            +    """                                                            
            +                                                                   
            +    def __init__(self, environ):                                   
            +        self.environ = environ                                     
            +        self.method = environ['REQUEST_METHOD']                    
            +        self.path = environ['PATH_INFO']                           
            +        self.query_string = environ.get('QUERY_STRING', '')        
            +                                                                   
            +        # Parse headers                                            
            +        self.headers = {}                                          
            +        for key, value in environ.items():                         
            +            if key.startswith('HTTP_'):                            
            +                header_name = key[5:].replace('_', '-').title()    
            +                self.headers[header_name] = value                  
            +                                                                   
            +        # Handle special headers                                   
            +        if 'CONTENT_TYPE' in environ:                              
            +            self.headers['Content-Type'] = environ['CONTENT_TYPE'] 
            +        if 'CONTENT_LENGTH' in environ:                            
            +            self.headers['Content-Length'] =                       
            environ['CONTENT_LENGTH']                                           
            +                                                                   
            +        # Parse query parameters                                   
            +        self.GET = urllib.parse.parse_qs(self.query_string,        
            keep_blank_values=True)                                             
            +                                                                   
            +        # Read body                                                
            +        try:                                                       
            +            content_length = int(environ.get('CONTENT_LENGTH', 0)) 
            +        except (ValueError, TypeError):                            
            +            content_length = 0                                     
            +                                                                   
            +        if content_length > 0:                                     
            +            self.body = environ['wsgi.input'].read(content_length) 
            +        else:                                                      
            +            self.body = b''                                        
            +                                                                   
            +        # Parse POST data if applicable                            
            +        if self.method == 'POST' and                               
            self.headers.get('Content-Type',                                    
            '').startswith('application/x-www-form-urlencoded'):                
            +            self.POST =                                            
            urllib.parse.parse_qs(self.body.decode('utf-8'),                    
            keep_blank_values=True)                                             
            +        else:                                                      
            +            self.POST = {}                                         
            +                                                                   
            +                                                                   
            +class HttpResponse:                                                
            +    """                                                            
            +    HTTP response object carrying status code, headers, and body.  
            +    """                                                            
            +                                                                   
            +    def __init__(self, content='', status=200,                     
            content_type='text/html; charset=utf-8'):                           
            +        self.content = content                                     
            +        self.status_code = status                                  
            +        self.headers = {'Content-Type': content_type}              
            +                                                                   
            +    def __iter__(self):                                            
            +        """Make response iterable for WSGI."""                     
            +        if isinstance(self.content, str):                          
            +            yield self.content.encode('utf-8')                     
            +        elif isinstance(self.content, bytes):                      
            +            yield self.content                                     
            +        else:                                                      
            +            yield str(self.content).encode('utf-8')                
            +                                                                   
            +    def get_status_text(self):                                     
            +        """Get HTTP status text."""                                
            +        status_texts = {                                           
            +            200: 'OK',                                             
            +            404: 'Not Found',                                      
            +            405: 'Method Not Allowed',                             
            +            500: 'Internal Server Error',                          
            +        }                                                          
            +        return status_texts.get(self.status_code, 'Unknown')       
            +                                                                   
            +                                                                   
            +class Http404(Exception):                                          
            +    """Exception for 404 Not Found responses."""                   
            +    pass                                                           
            +                                                                   
            +                                                                   
            +class HttpResponseNotFound(HttpResponse):                          
            +    """404 Not Found response."""                                  
            +                                                                   
            +    def __init__(self, content='Not Found'):                       
            +        super().__init__(content, status=404)                      
            +                                                                   
            +                                                                   
            +class HttpResponseNotAllowed(HttpResponse):                        
            +    """405 Method Not Allowed response."""                         
            +                                                                   
            +    def __init__(self, allowed_methods, content='Method Not        
            Allowed'):                                                          
            +        super().__init__(content, status=405)                      
            +        self.headers['Allow'] = ', '.join(allowed_methods)         
            diff --git a/djangoframework/urls.py b/djangoframework/urls.py      
            new file mode 100644                                                
            index 0000000..5a3b79a                                              
            --- /dev/null                                                       
            +++ b/djangoframework/urls.py                                       
            @@ -0,0 +1,181 @@                                                   
            +"""                                                                
            +URL routing and pattern matching.                                  
            +"""                                                                
            +                                                                   
            +import re                                                          
            +import uuid                                                        
            +from typing import Dict, Any, Callable, List, Optional, Union      
            +                                                                   
            +                                                                   
            +class Converter:                                                   
            +    """Base class for URL parameter converters."""                 
            +                                                                   
            +    regex = '[^/]+'                                                
            +                                                                   
            +    def to_python(self, value: str) -> Any:                        
            +        """Convert URL string to Python value."""                  
            +        return value                                               
            +                                                                   
            +    def to_url(self, value: Any) -> str:                           
            +        """Convert Python value to URL string."""                  
            +        return str(value)                                          
            +                                                                   
            +                                                                   
            +class StringConverter(Converter):                                  
            +    """String converter (default)."""                              
            +    regex = '[^/]+'                                                
            +                                                                   
            +                                                                   
            +class IntConverter(Converter):                                     
            +    """Integer converter."""                                       
            +    regex = r'\d+'                                                 
            +                                                                   
            +    def to_python(self, value: str) -> int:                        
            +        return int(value)                                          
            +                                                                   
            +                                                                   
            +class SlugConverter(Converter):                                    
            +    """Slug converter (letters, numbers, hyphens, underscores).""" 
            +    regex = r'[-a-zA-Z0-9_]+'                                      
            +                                                                   
            +                                                                   
            +class UUIDConverter(Converter):                                    
            +    """UUID converter."""                                          
            +    regex =                                                        
            r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'     
            +                                                                   
            +    def to_python(self, value: str) -> uuid.UUID:                  
            +        return uuid.UUID(value)                                    
            +                                                                   
            +    def to_url(self, value: uuid.UUID) -> str:                     
            +        return str(value)                                          
            +                                                                   
            +                                                                   
            +class PathConverter(Converter):                                    
            +    """Path converter (includes slashes)."""                       
            +    regex = r'.+'                                                  
            +                                                                   
            +                                                                   
            +# Default converters                                               
            +DEFAULT_CONVERTERS = {                                             
            +    'str': StringConverter(),                                      
            +    'int': IntConverter(),                                         
            +    'slug': SlugConverter(),                                       
            +    'uuid': UUIDConverter(),                                       
            +    'path': PathConverter(),                                       
            +}                                                                  
            +                                                                   
            +                                                                   
            +class URLPattern:                                                  
            +    """Represents a URL pattern with optional parameters."""       
            +                                                                   
            +    def __init__(self, pattern: str, view: Callable, name:         
            Optional[str] = None):                                              
            +        self.pattern = pattern                                     
            +        self.view = view                                           
            +        self.name = name                                           
            +        self.regex = None                                          
            +        self.param_names = []                                      
            +        self.converters = {}                                       
            +        self._compile_pattern()                                    
            +                                                                   
            +    def _compile_pattern(self):                                    
            +        """Compile the URL pattern into a regex."""                
            +        # Handle angle bracket parameters like <int:id> or         
            <str:name>                                                          
            +        param_pattern = r'<(?:(?P<converter>\w+):)?(?P<name>\w+)>' 
            +                                                                   
            +        def replace_param(match):                                  
            +            converter_name = match.group('converter') or 'str'     
            +            param_name = match.group('name')                       
            +                                                                   
            +            if converter_name not in DEFAULT_CONVERTERS:           
            +                raise ValueError(f"Unknown converter:              
            {converter_name}")                                                  
            +                                                                   
            +            converter = DEFAULT_CONVERTERS[converter_name]         
            +            self.param_names.append(param_name)                    
            +            self.converters[param_name] = converter                
            +                                                                   
            +            return f'(?P<{param_name}>{converter.regex})'          
            +                                                                   
            +        # Replace parameters with named groups                     
            +        regex_pattern = re.sub(param_pattern, replace_param,       
            self.pattern)                                                       
            +                                                                   
            +        # Ensure pattern matches from start to end                 
            +        if not regex_pattern.startswith('^'):                      
            +            regex_pattern = '^' + regex_pattern                    
            +        if not regex_pattern.endswith('$'):                        
            +            regex_pattern = regex_pattern + '$'                    
            +                                                                   
            +        self.regex = re.compile(regex_pattern)                     
            +                                                                   
            +    def match(self, path: str) -> Optional[Dict[str, Any]]:        
            +        """Try to match the path against this pattern."""          
            +        # Remove leading slash for matching (Django-style)         
            +        if path.startswith('/'):                                   
            +            path = path[1:]                                        
            +                                                                   
            +        match = self.regex.match(path)                             
            +        if not match:                                              
            +            return None                                            
            +                                                                   
            +        # Convert matched parameters using their converters        
            +        kwargs = {}                                                
            +        for name, value in match.groupdict().items():              
            +            if name in self.converters:                            
            +                kwargs[name] =                                     
            self.converters[name].to_python(value)                              
            +            else:                                                  
            +                kwargs[name] = value                               
            +                                                                   
            +        return kwargs                                              
            +                                                                   
            +                                                                   
            +class RegexURLPattern:                                             
            +    """URL pattern using regular expressions."""                   
            +                                                                   
            +    def __init__(self, regex: str, view: Callable, name:           
            Optional[str] = None):                                              
            +        self.regex = re.compile(regex)                             
            +        self.view = view                                           
            +        self.name = name                                           
            +                                                                   
            +    def match(self, path: str) -> Optional[Dict[str, Any]]:        
            +        """Try to match the path against this regex pattern."""    
            +        # Remove leading slash for consistency with URLPattern     
            +        if path.startswith('/'):                                   
            +            path = path[1:]                                        
            +                                                                   
            +        match = self.regex.match(path)                             
            +        if not match:                                              
            +            return None                                            
            +                                                                   
            +        return match.groupdict()                                   
            +                                                                   
            +                                                                   
            +class URLResolver:                                                 
            +    """Resolves URLs to views."""                                  
            +                                                                   
            +    def __init__(self, patterns: List[Union[URLPattern,            
            RegexURLPattern]]):                                                 
            +        self.patterns = patterns                                   
            +                                                                   
            +    def resolve(self, path: str):                                  
            +        """Resolve a path to a view and parameters."""             
            +        for pattern in self.patterns:                              
            +            kwargs = pattern.match(path)                           
            +            if kwargs is not None:                                 
            +                return pattern.view, kwargs                        
            +                                                                   
            +        # No pattern matched                                       
            +        from .http import Http404                                  
            +        raise Http404(f"No URL pattern matches '{path}'")          
            +                                                                   
            +                                                                   
            +def path(route: str, view: Callable, name: Optional[str] = None) ->
            URLPattern:                                                         
            +    """Create a URL pattern with parameter conversion."""          
            +    return URLPattern(route, view, name)                           
            +                                                                   
            +                                                                   
            +def re_path(regex: str, view: Callable, name: Optional[str] = None)
            -> RegexURLPattern:                                                 
            +    """Create a URL pattern using regular expressions."""          
            +    return RegexURLPattern(regex, view, name)                      
            +                                                                   
            +                                                                   
            +def include(patterns: List[Union[URLPattern, RegexURLPattern]]) -> 
            List[Union[URLPattern, RegexURLPattern]]:                           
            +    """Include a list of URL patterns."""                          
            +    return patterns                                                
            diff --git a/djangoframework/views.py b/djangoframework/views.py    
            new file mode 100644                                                
            index 0000000..5eba16e                                              
            --- /dev/null                                                       
            +++ b/djangoframework/views.py                                      
            @@ -0,0 +1,93 @@                                                    
            +"""                                                                
            +Class-based views implementation.                                  
            +"""                                                                
            +                                                                   
            +from .http import HttpRequest, HttpResponse, HttpResponseNotAllowed
            +                                                                   
            +                                                                   
            +class View:                                                        
            +    """                                                            
            +    Base class for class-based views.                              
            +                                                                   
            +    Dispatches requests to methods named for HTTP verbs.           
            +    Returns 405 with Allow header for unsupported methods.         
            +    Serves HEAD from GET implementation.                           
            +    """                                                            
            +                                                                   
            +    http_method_names = ['get', 'post', 'put', 'patch', 'delete',  
            'head', 'options', 'trace']                                         
            +                                                                   
            +    def __init__(self, **kwargs):                                  
            +        """Initialize the view instance."""                        
            +        for key, value in kwargs.items():                          
            +            setattr(self, key, value)                              
            +                                                                   
            +    @classmethod                                                   
            +    def as_view(cls, **initkwargs):                                
            +        """                                                        
            +        Main entry point for a request-response process.           
            +        Returns a view function that can be used in URL patterns.  
            +        """                                                        
            +        def view(request, *args, **kwargs):                        
            +            self = cls(**initkwargs)                               
            +            return self.dispatch(request, *args, **kwargs)         
            +                                                                   
            +        view.view_class = cls                                      
            +        view.view_initkwargs = initkwargs                          
            +                                                                   
            +        return view                                                
            +                                                                   
            +    def dispatch(self, request, *args, **kwargs):                  
            +        """                                                        
            +        Try to dispatch to the right method; if a method doesn't   
            exist,                                                              
            +        defer to the error handler. Also defer to the error handler
            if the                                                              
            +        request method isn't on the approved list.                 
            +        """                                                        
            +        if request.method.lower() in self.http_method_names:       
            +            handler = getattr(self, request.method.lower(),        
            self.http_method_not_allowed)                                       
            +        else:                                                      
            +            handler = self.http_method_not_allowed                 
            +                                                                   
            +        return handler(request, *args, **kwargs)                   
            +                                                                   
            +    def http_method_not_allowed(self, request, *args, **kwargs):   
            +        """                                                        
            +        Return a 405 Method Not Allowed response with the Allow    
            header                                                              
            +        listing the methods this view supports.                    
            +        """                                                        
            +        allowed_methods = []                                       
            +        for method in self.http_method_names:                      
            +            if hasattr(self, method):                              
            +                allowed_methods.append(method.upper())             
            +                                                                   
            +        # Special case: if GET is implemented, HEAD is             
            automatically supported                                             
            +        if 'GET' in allowed_methods and 'HEAD' not in              
            allowed_methods:                                                    
            +            allowed_methods.append('HEAD')                         
            +                                                                   
            +        return HttpResponseNotAllowed(allowed_methods)             
            +                                                                   
            +    def options(self, request, *args, **kwargs):                   
            +        """Handle responding to requests for the OPTIONS HTTP      
            verb."""                                                            
            +        allowed_methods = []                                       
            +        for method in self.http_method_names:                      
            +            if hasattr(self, method):                              
            +                allowed_methods.append(method.upper())             
            +                                                                   
            +        # Special case: if GET is implemented, HEAD is             
            automatically supported                                             
            +        if 'GET' in allowed_methods and 'HEAD' not in              
            allowed_methods:                                                    
            +            allowed_methods.append('HEAD')                         
            +                                                                   
            +        response = HttpResponse()                                  
            +        response.headers['Allow'] = ', '.join(allowed_methods)     
            +        return response                                            
            +                                                                   
            +    def head(self, request, *args, **kwargs):                      
            +        """                                                        
            +        Handle HEAD requests by calling GET and returning empty    
            content.                                                            
            +        """                                                        
            +        if hasattr(self, 'get'):                                   
            +            response = self.get(request, *args, **kwargs)          
            +            # Clear the content for HEAD requests                  
            +            response.content = ''                                  
            +            return response                                        
            +        else:                                                      
            +            return self.http_method_not_allowed(request, *args,    
            **kwargs)                                                           
            diff --git a/djangoframework/wsgi.py b/djangoframework/wsgi.py      
            new file mode 100644                                                
            index 0000000..e19b73d                                              
            --- /dev/null                                                       
            +++ b/djangoframework/wsgi.py                                       
            @@ -0,0 +1,98 @@                                                    
            +"""                                                                
            +WSGI application implementation.                                   
            +"""                                                                
            +                                                                   
            +import traceback                                                   
            +from typing import List, Union, Callable                           
            +                                                                   
            +from .http import HttpRequest, HttpResponse, HttpResponseNotFound, 
            Http404                                                             
            +from .urls import URLPattern, RegexURLPattern, URLResolver         
            +                                                                   
            +                                                                   
            +class WSGIApplication:                                             
            +    """                                                            
            +    WSGI-compatible application that handles URL routing and view  
            dispatching.                                                        
            +    """                                                            
            +                                                                   
            +    def __init__(self, urlpatterns: List[Union[URLPattern,         
            RegexURLPattern]]):                                                 
            +        """Initialize the WSGI application with URL patterns."""   
            +        self.resolver = URLResolver(urlpatterns)                   
            +                                                                   
            +    def __call__(self, environ, start_response):                   
            +        """                                                        
            +        WSGI application callable.                                 
            +                                                                   
            +        Args:                                                      
            +            environ: WSGI environment dictionary                   
            +            start_response: WSGI start_response callable           
            +                                                                   
            +        Returns:                                                   
            +            Iterable of response body bytes                        
            +        """                                                        
            +        try:                                                       
            +            # Create request object                                
            +            request = HttpRequest(environ)                         
            +                                                                   
            +            # Resolve URL to view and parameters                   
            +            try:                                                   
            +                view, kwargs = self.resolver.resolve(request.path) 
            +            except Http404:                                        
            +                response = HttpResponseNotFound()                  
            +            else:                                                  
            +                # Call the view with request and captured          
            parameters                                                          
            +                try:                                               
            +                    response = view(request, **kwargs)             
            +                except Exception as e:                             
            +                    # Handle view exceptions                       
            +                    response = HttpResponse(                       
            +                        f'Internal Server Error: {str(e)}',        
            +                        status=500,                                
            +                        content_type='text/plain'                  
            +                    )                                              
            +                                                                   
            +            # Ensure we have an HttpResponse object                
            +            if not isinstance(response, HttpResponse):             
            +                response = HttpResponse(str(response))             
            +                                                                   
            +            # Start the response                                   
            +            status = f'{response.status_code}                      
            {response.get_status_text()}'                                       
            +            headers = [(key, value) for key, value in              
            response.headers.items()]                                           
            +                                                                   
            +            # Add Content-Length header                            
            +            content = b''.join(response)                           
            +            headers.append(('Content-Length', str(len(content))))  
            +                                                                   
            +            start_response(status, headers)                        
            +                                                                   
            +            # Return response content                              
            +            return [content]                                       
            +                                                                   
            +        except Exception as e:                                     
            +            # Handle any unexpected errors                         
            +            error_response = HttpResponse(                         
            +                f'Internal Server Error:                           
            {str(e)}\n\n{traceback.format_exc()}',                              
            +                status=500,                                        
            +                content_type='text/plain'                          
            +            )                                                      
            +                                                                   
            +            status = f'{error_response.status_code}                
            {error_response.get_status_text()}'                                 
            +            headers = [(key, value) for key, value in              
            error_response.headers.items()]                                     
            +                                                                   
            +            content = b''.join(error_response)                     
            +            headers.append(('Content-Length', str(len(content))))  
            +                                                                   
            +            start_response(status, headers)                        
            +            return [content]                                       
            +                                                                   
            +                                                                   
            +def get_wsgi_application(urlpatterns: List[Union[URLPattern,       
            RegexURLPattern]]) -> WSGIApplication:                              
            +    """                                                            
            +    Create and return a WSGI application.                          
            +                                                                   
            +    Args:                                                          
            +        urlpatterns: List of URL patterns                          
            +                                                                   
            +    Returns:                                                       
            +        WSGIApplication instance                                   
            +    """                                                            
            +    return WSGIApplication(urlpatterns)                            
            diff --git a/example_app.py b/example_app.py                        
            new file mode 100644                                                
            index 0000000..300f040                                              
            --- /dev/null                                                       
            +++ b/example_app.py                                                
            @@ -0,0 +1,188 @@                                                   
            +#!/usr/bin/env python3                                             
            +"""                                                                
            +Example Django Framework application demonstrating all features.   
            +"""                                                                
            +                                                                   
            +import uuid                                                        
            +from djangoframework import (                                      
            +    path, re_path, HttpRequest, HttpResponse, View, WSGIApplication
            +)                                                                  
            +                                                                   
            +                                                                   
            +# Function-based views                                             
            +def home(request):                                                 
            +    """Home page view."""                                          
            +    return HttpResponse("""                                        
            +    <html>                                                         
            +    <head><title>Django Framework Demo</title></head>              
            +    <body>                                                         
            +        <h1>Welcome to Django Framework!</h1>                      
            +        <p>This is a demonstration of the Django-like WSGI         
            framework.</p>                                                      
            +        <ul>                                                       
            +            <li><a href="/hello/world/">Hello World</a></li>       
            +            <li><a href="/article/123/">Article 123</a></li>       
            +            <li><a href="/category/python-tips/">Python Tips       
            Category</a></li>                                                   
            +            <li><a href="/files/docs/readme.txt/">File Path        
            Example</a></li>                                                    
            +            <li><a href="/archive/2023/">Archive 2023</a></li>     
            +            <li><a href="/api/">API View (Class-based)</a></li>    
            +        </ul>                                                      
            +    </body>                                                        
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def hello_view(request, name):                                     
            +    """Greet a user by name."""                                    
            +    return HttpResponse(f"""                                       
            +    <html>                                                         
            +    <head><title>Hello {name}</title></head>                       
            +    <body>                                                         
            +        <h1>Hello, {name}!</h1>                                    
            +        <p>This demonstrates string parameter conversion.</p>      
            +        <a href="/">Back to home</a>                               
            +    </body>                                                        
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def article_view(request, id):                                     
            +    """Display an article by ID."""                                
            +    return HttpResponse(f"""                                       
            +    <html>                                                         
            +    <head><title>Article {id}</title></head>                       
            +    <body>                                                         
            +        <h1>Article #{id}</h1>                                     
            +        <p>This demonstrates integer parameter conversion.</p>     
            +        <p>The ID parameter is of type: {type(id).__name__}</p>    
            +        <a href="/">Back to home</a>                               
            +    </body>                                                        
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def category_view(request, category):                              
            +    """Display a category page."""                                 
            +    return HttpResponse(f"""                                       
            +    <html>                                                         
            +    <head><title>Category: {category}</title></head>               
            +    <body>                                                         
            +        <h1>Category: {category}</h1>                              
            +        <p>This demonstrates slug parameter conversion.</p>        
            +        <a href="/">Back to home</a>                               
            +    </body>                                                        
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def file_view(request, filepath):                                  
            +    """Display file path."""                                       
            +    return HttpResponse(f"""                                       
            +    <html>                                                         
            +    <head><title>File: {filepath}</title></head>                   
            +    <body>                                                         
            +        <h1>File Path: {filepath}</h1>                             
            +        <p>This demonstrates path parameter conversion (includes   
            slashes).</p>                                                       
            +        <a href="/">Back to home</a>                               
            +    </body>                                                        
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def archive_view(request, year):                                   
            +    """Archive view using regex pattern."""                        
            +    return HttpResponse(f"""                                       
            +    <html>                                                         
            +    <head><title>Archive {year}</title></head>                     
            +    <body>                                                         
            +        <h1>Archive for {year}</h1>                                
            +        <p>This demonstrates regex URL patterns.</p>               
            +        <a href="/">Back to home</a>                               
            +    </body>                                                        
            +    </html>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +# Class-based view                                                 
            +class APIView(View):                                               
            +    """Example API view demonstrating class-based views."""        
            +                                                                   
            +    def get(self, request, *args, **kwargs):                       
            +        """Handle GET requests."""                                 
            +        return HttpResponse("""                                    
            +        <html>                                                     
            +        <head><title>API - GET</title></head>                      
            +        <body>                                                     
            +            <h1>API View - GET Method</h1>                         
            +            <p>This demonstrates class-based views with GET        
            method.</p>                                                         
            +            <p>Try sending a POST request to see method dispatch in
            action.</p>                                                         
            +            <form method="post">                                   
            +                <button type="submit">Send POST Request</button>   
            +            </form>                                                
            +            <a href="/">Back to home</a>                           
            +        </body>                                                    
            +        </html>                                                    
            +        """)                                                       
            +                                                                   
            +    def post(self, request, *args, **kwargs):                      
            +        """Handle POST requests."""                                
            +        return HttpResponse("""                                    
            +        <html>                                                     
            +        <head><title>API - POST</title></head>                     
            +        <body>                                                     
            +            <h1>API View - POST Method</h1>                        
            +            <p>This demonstrates class-based views with POST       
            method.</p>                                                         
            +            <p>The view automatically dispatched to the POST       
            method!</p>                                                         
            +            <a href="/api/">Back to API (GET)</a> | <a             
            href="/">Back to home</a>                                           
            +        </body>                                                    
            +        </html>                                                    
            +        """)                                                       
            +                                                                   
            +                                                                   
            +class GetOnlyView(View):                                           
            +    """View that only supports GET to demonstrate 405 handling.""" 
            +                                                                   
            +    def get(self, request, *args, **kwargs):                       
            +        """Handle GET requests only."""                            
            +        return HttpResponse("""                                    
            +        <html>                                                     
            +        <head><title>GET Only View</title></head>                  
            +        <body>                                                     
            +            <h1>GET Only View</h1>                                 
            +            <p>This view only supports GET requests.</p>           
            +            <p>Try sending a POST request to see 405 Method Not    
            Allowed response.</p>                                               
            +            <a href="/">Back to home</a>                           
            +        </body>                                                    
            +        </html>                                                    
            +        """)                                                       
            +                                                                   
            +                                                                   
            +# URL patterns                                                     
            +urlpatterns = [                                                    
            +    path('', home),                                                
            +    path('hello/<str:name>/', hello_view),                         
            +    path('article/<int:id>/', article_view),                       
            +    path('category/<slug:category>/', category_view),              
            +    path('files/<path:filepath>/', file_view),                     
            +    re_path(r'^archive/(?P<year>[0-9]{4})/$', archive_view),       
            +    path('api/', APIView.as_view()),                               
            +    path('get-only/', GetOnlyView.as_view()),                      
            +]                                                                  
            +                                                                   
            +                                                                   
            +# Create WSGI application                                          
            +application = WSGIApplication(urlpatterns)                         
            +                                                                   
            +                                                                   
            +if __name__ == '__main__':                                         
            +    # Simple development server for testing                        
            +    from wsgiref.simple_server import make_server                  
            +                                                                   
            +    print("Starting Django Framework development server...")       
            +    print("Visit http://localhost:8000/ to see the demo")          
            +    print("Press Ctrl+C to stop the server")                       
            +                                                                   
            +    with make_server('localhost', 8000, application) as httpd:     
            +        try:                                                       
            +            httpd.serve_forever()                                  
            +        except KeyboardInterrupt:                                  
            +            print("\nServer stopped.")                             
