             requires-python = ">=3.11"                                         
            -dependencies = ["jinja2", "werkzeug", "pytest"]                    
            +authors = [                                                        
            +    {name = "Django Framework", email = "django@example.com"},     
            +]                                                                  
            +classifiers = [                                                    
