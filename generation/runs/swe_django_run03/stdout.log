            78:    # Simple paths                                               
            79:    path('', home_view),                                         
            80:    path('about/', about_view),                                  
            81:                                                                 
            82:    # Parameters with type conversion                            
            83:    path('user/<int:user_id>/', user_detail),                    
            84:    path('post/<slug:slug>/', post_detail),                      
            85:    path('file/<path:filepath>/', serve_file),                   
            86:    path('item/<uuid:item_id>/', item_detail),                   
            87:                                                                 
            88:    # Regular expressions                                        
            89:    re_path(r'^articles/(?P<year>[0-9]{4})/$', year_archive),    
            90:]                                                                
            91:```                                                              
