                            <button type="submit">Submit POST</button>          
                        </form>                                                 
                        <p><a href="/">Back to Home</a></p>                     
                    </body>                                                     
                    </html>                                                     
                    """)                                                        
                                                                                
                def post(self, request, *args, **kwargs):                       
