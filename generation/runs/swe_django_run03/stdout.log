            +        'SERVER_NAME': 'testserver',                               
            +        'SERVER_PORT': '80',                                       
            +    }                                                              
            +                                                                   
            +                                                                   
            +# Test views                                                       
            +def home(request):                                                 
            +    return HttpResponse("Django Framework Integration Test")       
            +                                                                   
            +                                                                   
            +def user_profile(request, user_id):                                
            +    return JsonResponse({                                          
            +        'user_id': user_id,                                        
            +        'type': type(user_id).__name__,                            
