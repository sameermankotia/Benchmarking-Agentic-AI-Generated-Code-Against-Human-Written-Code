            index 0000000..1d4a275                                              
            --- /dev/null                                                       
            +++ b/djangoframework/urls.py                                       
            @@ -0,0 +1,182 @@                                                   
            +"""                                                                
            +URL routing system with pattern matching and converters.           
            +"""                                                                
            +import re                                                          
            +import uuid                                                        
            +from .http import Http404                                          
            +                                                                   
            +                                                                   
            +class Converter:                                                   
            +    """Base class for URL parameter converters."""                 
            +    regex = '[^/]+'                                                
            +                                                                   
            +    def to_python(self, value):                                    
            +        return value                                               
            +                                                                   
            +    def to_url(self, value):                                       
            +        return str(value)                                          
            +                                                                   
            +                                                                   
            +class StringConverter(Converter):                                  
            +    """Converter for string parameters."""                         
            +    regex = '[^/]+'                                                
            +                                                                   
            +                                                                   
            +class IntConverter(Converter):                                     
            +    """Converter for integer parameters."""                        
            +    regex = r'[0-9]+'                                              
            +                                                                   
            +    def to_python(self, value):                                    
            +        return int(value)                                          
            +                                                                   
            +                                                                   
            +class SlugConverter(Converter):                                    
            +    """Converter for slug parameters (letters, numbers, hyphens,   
            underscores)."""                                                    
            +    regex = r'[-a-zA-Z0-9_]+'                                      
            +                                                                   
            +                                                                   
            +class UUIDConverter(Converter):                                    
            +    """Converter for UUID parameters."""                           
            +    regex =                                                        
            r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'     
            +                                                                   
            +    def to_python(self, value):                                    
            +        return uuid.UUID(value)                                    
            +                                                                   
            +                                                                   
            +class PathConverter(Converter):                                    
            +    """Converter for path parameters (includes slashes)."""        
            +    regex = r'.+'                                                  
            +                                                                   
            +                                                                   
            +# Registry of available converters                                 
            +DEFAULT_CONVERTERS = {                                             
            +    'str': StringConverter(),                                      
            +    'int': IntConverter(),                                         
            +    'slug': SlugConverter(),                                       
            +    'uuid': UUIDConverter(),                                       
            +    'path': PathConverter(),                                       
            +}                                                                  
            +                                                                   
            +                                                                   
            +class URLPattern:                                                  
            +    """                                                            
            +    A URL pattern that can match against a path and extract        
            parameters.                                                         
            +    """                                                            
            +                                                                   
            +    def __init__(self, pattern, view, name=None, converters=None): 
            +        self.pattern = pattern                                     
            +        self.view = view                                           
            +        self.name = name                                           
            +        self.converters = converters or DEFAULT_CONVERTERS.copy()  
            +                                                                   
            +        # Compile the pattern into a regex                         
            +        self._compile_pattern()                                    
            +                                                                   
            +    def _compile_pattern(self):                                    
            +        """Convert Django-style URL pattern to regex."""           
            +        # Handle angle bracket parameters like <int:id>            
            +        param_pattern = r'<(?:(\w+):)?(\w+)>'                      
            +                                                                   
            +        def replace_param(match):                                  
            +            converter_name = match.group(1) or 'str'               
            +            param_name = match.group(2)                            
            +                                                                   
            +            if converter_name not in self.converters:              
            +                raise ValueError(f"Unknown converter:              
            {converter_name}")                                                  
            +                                                                   
            +            converter = self.converters[converter_name]            
            +            return f'(?P<{param_name}>{converter.regex})'          
            +                                                                   
            +        # Replace parameters with named groups                     
            +        regex_pattern = re.sub(param_pattern, replace_param,       
            self.pattern)                                                       
            +                                                                   
            +        # Ensure pattern matches from start to end                 
            +        if not regex_pattern.startswith('^'):                      
            +            regex_pattern = '^' + regex_pattern                    
            +        if not regex_pattern.endswith('$'):                        
            +            regex_pattern = regex_pattern + '$'                    
            +                                                                   
            +        self.regex = re.compile(regex_pattern)                     
            +                                                                   
            +        # Extract parameter info for conversion                    
            +        self.param_converters = {}                                 
            +        for match in re.finditer(param_pattern, self.pattern):     
            +            converter_name = match.group(1) or 'str'               
            +            param_name = match.group(2)                            
            +            self.param_converters[param_name] =                    
            self.converters[converter_name]                                     
            +                                                                   
            +    def match(self, path):                                         
            +        """                                                        
            +        Try to match the path against this pattern.                
            +        Returns (view, kwargs) if match, None otherwise.           
            +        """                                                        
            +        match = self.regex.match(path)                             
            +        if not match:                                              
            +            return None                                            
            +                                                                   
            +        # Convert matched parameters using their converters        
            +        kwargs = {}                                                
            +        for name, value in match.groupdict().items():              
            +            converter = self.param_converters.get(name,            
            self.converters['str'])                                             
            +            kwargs[name] = converter.to_python(value)              
            +                                                                   
            +        return self.view, kwargs                                   
            +                                                                   
            +                                                                   
            +class RegexURLPattern:                                             
            +    """                                                            
            +    A URL pattern using raw regular expressions.                   
            +    """                                                            
            +                                                                   
            +    def __init__(self, regex, view, name=None):                    
            +        self.regex = re.compile(regex)                             
            +        self.view = view                                           
            +        self.name = name                                           
            +                                                                   
            +    def match(self, path):                                         
            +        """                                                        
            +        Try to match the path against this regex pattern.          
            +        Returns (view, kwargs) if match, None otherwise.           
            +        """                                                        
            +        match = self.regex.match(path)                             
            +        if not match:                                              
            +            return None                                            
            +                                                                   
            +        # Use named groups as kwargs                               
            +        kwargs = match.groupdict()                                 
            +        return self.view, kwargs                                   
            +                                                                   
            +                                                                   
            +class URLResolver:                                                 
            +    """                                                            
            +    Resolves URLs by trying patterns in order until one matches.   
            +    """                                                            
            +                                                                   
            +    def __init__(self, patterns):                                  
            +        self.patterns = patterns                                   
            +                                                                   
            +    def resolve(self, path):                                       
            +        """                                                        
            +        Resolve a path to a view and kwargs.                       
            +        Raises Http404 if no pattern matches.                      
            +        """                                                        
            +        for pattern in self.patterns:                              
            +            result = pattern.match(path)                           
            +            if result:                                             
            +                return result                                      
            +                                                                   
            +        raise Http404(f"No URL pattern matches '{path}'")          
            +                                                                   
            +                                                                   
            +def path(route, view, name=None):                                  
            +    """                                                            
            +    Create a URL pattern with Django-style parameter syntax.       
            +    """                                                            
            +    return URLPattern(route, view, name)                           
            +                                                                   
            +                                                                   
            +def re_path(regex, view, name=None):                               
            +    """                                                            
            +    Create a URL pattern using raw regular expressions.            
            +    """                                                            
            +    return RegexURLPattern(regex, view, name)                      
            diff --git a/djangoframework/views.py b/djangoframework/views.py    
            new file mode 100644                                                
            index 0000000..008e957                                              
            --- /dev/null                                                       
            +++ b/djangoframework/views.py                                      
            @@ -0,0 +1,84 @@                                                    
            +"""                                                                
            +Class-based views with HTTP method dispatch.                       
            +"""                                                                
            +from .http import HttpResponse, Http405                            
            +                                                                   
            +                                                                   
            +class View:                                                        
            +    """                                                            
            +    Base class for class-based views that dispatch requests to     
            methods                                                             
            +    named for the HTTP verb.                                       
            +    """                                                            
            +                                                                   
            +    http_method_names = ['get', 'post', 'put', 'patch', 'delete',  
            'head', 'options', 'trace']                                         
            +                                                                   
            +    def __init__(self, **kwargs):                                  
            +        """                                                        
            +        Constructor. Called in the URLconf; can contain helpful    
            extra                                                               
            +        keyword arguments, and other things.                       
            +        """                                                        
            +        # Go through keyword arguments, and either save their      
            values to our                                                       
            +        # instance, or raise an error.                             
            +        for key, value in kwargs.items():                          
            +            setattr(self, key, value)                              
            +                                                                   
            +    @classmethod                                                   
            +    def as_view(cls, **initkwargs):                                
            +        """                                                        
            +        Main entry point for a request-response process.           
            +        """                                                        
            +        def view(request, *args, **kwargs):                        
            +            self = cls(**initkwargs)                               
            +            return self.dispatch(request, *args, **kwargs)         
            +                                                                   
            +        # Copy class attributes to the view function               
            +        view.view_class = cls                                      
            +        view.view_initkwargs = initkwargs                          
            +                                                                   
            +        return view                                                
            +                                                                   
            +    def dispatch(self, request, *args, **kwargs):                  
            +        """                                                        
            +        Try to dispatch to the right method; if a method doesn't   
            exist,                                                              
            +        defer to the error handler. Also defer to the error handler
            if the                                                              
            +        request method isn't on the approved list.                 
            +        """                                                        
            +        if request.method.lower() in self.http_method_names:       
            +            handler = getattr(self, request.method.lower(),        
            self.http_method_not_allowed)                                       
            +        else:                                                      
            +            handler = self.http_method_not_allowed                 
            +                                                                   
            +        return handler(request, *args, **kwargs)                   
            +                                                                   
            +    def http_method_not_allowed(self, request, *args, **kwargs):   
            +        """                                                        
            +        Handle requests for methods not implemented by this view.  
            +        Returns 405 with Allow header listing implemented methods. 
            +        """                                                        
            +        allowed_methods = []                                       
            +        for method in self.http_method_names:                      
            +            if hasattr(self, method):                              
            +                allowed_methods.append(method.upper())             
            +                                                                   
            +        # Handle HEAD requests if GET is implemented               
            +        if 'GET' in allowed_methods and 'HEAD' not in              
            allowed_methods:                                                    
            +            allowed_methods.append('HEAD')                         
            +                                                                   
            +        response = HttpResponse(                                   
            +            content=f'Method {request.method} not allowed.',       
            +            status=405                                             
            +        )                                                          
            +        response.headers['Allow'] = ', '.join(allowed_methods)     
            +        return response                                            
            +                                                                   
            +    def head(self, request, *args, **kwargs):                      
            +        """                                                        
            +        Handle HEAD requests by calling GET and returning empty    
            body.                                                               
            +        """                                                        
            +        if hasattr(self, 'get'):                                   
            +            response = self.get(request, *args, **kwargs)          
            +            # Clear the content for HEAD requests                  
            +            response.content = ''                                  
            +            return response                                        
            +        else:                                                      
            +            return self.http_method_not_allowed(request, *args,    
            **kwargs)                                                           
            diff --git a/djangoframework/wsgi.py b/djangoframework/wsgi.py      
            new file mode 100644                                                
            index 0000000..179c05f                                              
            --- /dev/null                                                       
            +++ b/djangoframework/wsgi.py                                       
            @@ -0,0 +1,77 @@                                                    
            +"""                                                                
            +WSGI application that handles URL routing and view dispatching.    
            +"""                                                                
            +import traceback                                                   
            +from .http import HttpRequest, HttpResponse, Http404               
            +from .urls import URLResolver                                      
            +                                                                   
            +                                                                   
            +class WSGIApplication:                                             
            +    """                                                            
            +    WSGI-compatible application that routes URLs and dispatches to 
            views.                                                              
            +    """                                                            
            +                                                                   
            +    def __init__(self, urlpatterns):                               
            +        self.url_resolver = URLResolver(urlpatterns)               
            +                                                                   
            +    def __call__(self, environ, start_response):                   
            +        """                                                        
            +        WSGI application entry point.                              
            +        """                                                        
            +        try:                                                       
            +            # Create request object                                
            +            request = HttpRequest(environ)                         
            +                                                                   
            +            # Resolve URL to view and kwargs                       
            +            # Strip leading slash to match Django's URL pattern    
            behavior                                                            
            +            path_to_resolve = request.path.lstrip('/')             
            +            try:                                                   
            +                view, kwargs =                                     
            self.url_resolver.resolve(path_to_resolve)                          
            +            except Http404:                                        
            +                response = HttpResponse(                           
            +                    content='<h1>404 Not Found</h1><p>The requested
            URL was not found on this server.</p>',                             
            +                    status=404                                     
            +                )                                                  
            +            else:                                                  
            +                # Call the view                                    
            +                try:                                               
            +                    response = view(request, **kwargs)             
            +                except Exception as e:                             
            +                    # Handle view exceptions                       
            +                    response = HttpResponse(                       
            +                        content=f'<h1>500 Internal Server          
            Error</h1><pre>{traceback.format_exc()}</pre>',                     
            +                        status=500                                 
            +                    )                                              
            +                                                                   
            +            # Ensure we have a valid response                      
            +            if not isinstance(response, HttpResponse):             
            +                response = HttpResponse(str(response))             
            +                                                                   
            +            # Start the response                                   
            +            status = f'{response.status_code}                      
            {response.get_status_text()}'                                       
            +            headers = [(key, value) for key, value in              
            response.headers.items()]                                           
            +                                                                   
            +            # Add Content-Length header                            
            +            content = b''.join(response)                           
            +            headers.append(('Content-Length', str(len(content))))  
            +                                                                   
            +            start_response(status, headers)                        
            +                                                                   
            +            # Return response content                              
            +            return [content]                                       
            +                                                                   
            +        except Exception as e:                                     
            +            # Handle any unexpected errors                         
            +            error_response = HttpResponse(                         
            +                content=f'<h1>500 Internal Server                  
            Error</h1><pre>{traceback.format_exc()}</pre>',                     
            +                status=500                                         
            +            )                                                      
            +                                                                   
            +            status = f'{error_response.status_code}                
            {error_response.get_status_text()}'                                 
            +            headers = [(key, value) for key, value in              
            error_response.headers.items()]                                     
            +                                                                   
            +            content = b''.join(error_response)                     
            +            headers.append(('Content-Length', str(len(content))))  
            +                                                                   
            +            start_response(status, headers)                        
            +            return [content]                                       
            diff --git a/example_app.py b/example_app.py                        
            new file mode 100644                                                
            index 0000000..fa90119                                              
            --- /dev/null                                                       
            +++ b/example_app.py                                                
            @@ -0,0 +1,100 @@                                                   
            +#!/usr/bin/env python3                                             
            +"""                                                                
            +Example application demonstrating the Django-style WSGI framework. 
            +"""                                                                
            +                                                                   
            +from djangoframework import WSGIApplication, HttpResponse, View,   
            path, re_path                                                       
            +                                                                   
            +                                                                   
            +# Function-based views                                             
            +def home(request):                                                 
            +    """Home page view."""                                          
            +    return HttpResponse("""                                        
            +    <h1>Welcome to Django Framework</h1>                           
            +    <p>This is a WSGI-compatible URL routing and view dispatching  
            framework.</p>                                                      
            +    <ul>                                                           
            +        <li><a href="/hello/World/">Hello World</a></li>           
            +        <li><a href="/user/123/">User Profile</a></li>             
            +        <li><a href="/article/456/">Article Detail</a></li>        
            +        <li><a href="/files/docs/readme.txt/">File View</a></li>   
            +        <li><a href="/archive/2023/">Archive</a></li>              
            +    </ul>                                                          
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def hello_view(request, name):                                     
            +    """Greet a user by name."""                                    
            +    return HttpResponse(f"<h1>Hello, {name}!</h1><p>Nice to meet   
            you.</p>")                                                          
            +                                                                   
            +                                                                   
            +def user_profile(request, user_id):                                
            +    """Display user profile."""                                    
            +    return HttpResponse(f"""                                       
            +    <h1>User Profile</h1>                                          
            +    <p>User ID: {user_id} (type: {type(user_id).__name__})</p>     
            +    <p>Method: {request.method}</p>                                
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def file_view(request, filepath):                                  
            +    """Display file path."""                                       
            +    return HttpResponse(f"""                                       
            +    <h1>File View</h1>                                             
            +    <p>File path: {filepath}</p>                                   
            +    <p>This demonstrates the path converter that includes          
            slashes.</p>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +def archive_view(request, year):                                   
            +    """Archive view using regex pattern."""                        
            +    return HttpResponse(f"""                                       
            +    <h1>Archive for {year}</h1>                                    
            +    <p>This view was matched using a regular expression            
            pattern.</p>                                                        
            +    """)                                                           
            +                                                                   
            +                                                                   
            +# Class-based view                                                 
            +class ArticleView(View):                                           
            +    """Article view with multiple HTTP methods."""                 
            +                                                                   
            +    def get(self, request, article_id):                            
            +        return HttpResponse(f"""                                   
            +        <h1>Article {article_id}</h1>                              
            +        <p>This is a GET request to view the article.</p>          
            +        <p>Try sending a POST request to update it.</p>            
            +        """)                                                       
            +                                                                   
            +    def post(self, request, article_id):                           
            +        return HttpResponse(f"""                                   
            +        <h1>Article {article_id} Updated</h1>                      
            +        <p>This is a POST request to update the article.</p>       
            +        """)                                                       
            +                                                                   
            +                                                                   
            +# URL patterns                                                     
            +urlpatterns = [                                                    
            +    path('', home),                                                
            +    path('hello/<str:name>/', hello_view),                         
            +    path('user/<int:user_id>/', user_profile),                     
            +    path('article/<int:article_id>/', ArticleView.as_view()),      
            +    path('files/<path:filepath>/', file_view),                     
            +    re_path(r'^archive/(?P<year>[0-9]{4})/$', archive_view),       
            +]                                                                  
            +                                                                   
            +# Create WSGI application                                          
            +application = WSGIApplication(urlpatterns)                         
            +                                                                   
            +                                                                   
            +if __name__ == '__main__':                                         
            +    # Run with Python's built-in WSGI server for testing           
            +    from wsgiref.simple_server import make_server                  
            +                                                                   
            +    print("Starting Django Framework example server...")           
            +    print("Visit http://localhost:8000 to see the application")    
            +    print("Press Ctrl+C to stop the server")                       
            +                                                                   
            +    server = make_server('localhost', 8000, application)           
            +    try:                                                           
            +        server.serve_forever()                                     
            +    except KeyboardInterrupt:                                      
            +        print("\nServer stopped.")                                 
            diff --git a/pyproject.toml b/pyproject.toml                        
            index ab70d8d..ce0a8c4 100644                                       
            --- a/pyproject.toml                                                
            +++ b/pyproject.toml                                                
            @@ -1,5 +1,30 @@                                                    
            +[build-system]                                                     
            +requires = ["setuptools>=61.0", "wheel"]                           
            +build-backend = "setuptools.build_meta"                            
            +                                                                   
             [project]                                                          
             name = "djangoframework"                                           
             version = "0.1.0"                                                  
            +description = "A WSGI-compatible URL routing and view dispatching  
            framework inspired by Django"                                       
             requires-python = ">=3.11"                                         
            -dependencies = ["jinja2", "werkzeug", "pytest"]                    
            +dependencies = []                                                  
            +authors = [                                                        
            +    {name = "Django Framework", email = "info@djangoframework.com"}
            +]                                                                  
            +readme = "README.md"                                               
            +license = {text = "MIT"}                                           
            +classifiers = [                                                    
            +    "Development Status :: 3 - Alpha",                             
            +    "Intended Audience :: Developers",                             
            +    "License :: OSI Approved :: MIT License",                      
            +    "Programming Language :: Python :: 3",                         
            +    "Programming Language :: Python :: 3.11",                      
            +    "Topic :: Internet :: WWW/HTTP :: WSGI",                       
            +    "Topic :: Software Development :: Libraries :: Python Modules",
            +]                                                                  
            +                                                                   
            +[project.optional-dependencies]                                    
            +dev = ["pytest>=7.0", "pytest-cov", "black", "flake8"]             
            +                                                                   
            +[tool.setuptools.packages.find]                                    
            +include = ["djangoframework*"]                                     
            diff --git a/test_framework.py b/test_framework.py                  
            new file mode 100644                                                
            index 0000000..f301407                                              
            --- /dev/null                                                       
            +++ b/test_framework.py                                             
            @@ -0,0 +1,403 @@                                                   
            +#!/usr/bin/env python3                                             
            +"""                                                                
            +Comprehensive test script for the Django-style WSGI framework.     
            +Tests all required functionality from the specification.           
            +"""                                                                
            +                                                                   
            +import uuid                                                        
            +import sys                                                         
            +import os                                                          
            +from io import BytesIO                                             
            +                                                                   
            +# Add the current directory to Python path                         
            +sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))     
            +                                                                   
            +from djangoframework import WSGIApplication, HttpResponse,         
            HttpRequest, View, path, re_path                                    
            +                                                                   
            +                                                                   
            +def test_basic_functionality():                                    
            +    """Test basic URL routing and view dispatch."""                
            +    print("Testing basic functionality...")                        
            +                                                                   
            +    def hello_world(request):                                      
            +        return HttpResponse("Hello, World!")                       
            +                                                                   
            +    def hello_name(request, name):                                 
            +        return HttpResponse(f"Hello, {name}!")                     
            +                                                                   
            +    urlpatterns = [                                                
            +        path('', hello_world),  # Empty string for root path       
            +        path('hello/<str:name>/', hello_name),                     
            +    ]                                                              
            +                                                                   
            +    app = WSGIApplication(urlpatterns)                             
            +                                                                   
            +    # Test root path                                               
            +    environ = {                                                    
            +        'REQUEST_METHOD': 'GET',                                   
            +        'PATH_INFO': '/',                                          
            +        'QUERY_STRING': '',                                        
            +        'wsgi.input': BytesIO(b''),                                
            +    }                                                              
            +                                                                   
            +    responses = []                                                 
            +    def start_response(status, headers):                           
            +        responses.append((status, headers))                        
            +                                                                   
            +    result = app(environ, start_response)                          
            +    content = b''.join(result)                                     
            +                                                                   
            +    assert responses[0][0] == '200 OK'                             
            +    assert b'Hello, World!' in content                             
            +    print("✓ Basic routing works")                                 
            +                                                                   
            +    # Test parameterized path                                      
            +    environ['PATH_INFO'] = '/hello/Django/'                        
            +    responses.clear()                                              
            +    result = app(environ, start_response)                          
            +    content = b''.join(result)                                     
            +                                                                   
            +    assert responses[0][0] == '200 OK'                             
            +    assert b'Hello, Django!' in content                            
            +    print("✓ Parameterized routing works")                         
            +                                                                   
            +                                                                   
            +def test_converters():                                             
            +    """Test all URL parameter converters."""                       
            +    print("\nTesting URL converters...")                           
            +                                                                   
            +    def int_view(request, id):                                     
            +        return HttpResponse(f"ID: {id} (type:                      
            {type(id).__name__})")                                              
            +                                                                   
            +    def slug_view(request, slug):                                  
            +        return HttpResponse(f"Slug: {slug}")                       
            +                                                                   
            +    def uuid_view(request, uuid_param):                            
            +        return HttpResponse(f"UUID: {uuid_param} (type:            
            {type(uuid_param).__name__})")                                      
            +                                                                   
            +    def path_view(request, filepath):                              
            +        return HttpResponse(f"Path: {filepath}")                   
            +                                                                   
            +    urlpatterns = [                                                
            +        path('int/<int:id>/', int_view),                           
            +        path('slug/<slug:slug>/', slug_view),                      
            +        path('uuid/<uuid:uuid_param>/', uuid_view),                
            +        path('path/<path:filepath>/', path_view),                  
            +    ]                                                              
            +                                                                   
            +    app = WSGIApplication(urlpatterns)                             
            +                                                                   
            +    def make_request(path_info):                                   
            +        environ = {                                                
            +            'REQUEST_METHOD': 'GET',                               
            +            'PATH_INFO': path_info,                                
            +            'QUERY_STRING': '',                                    
            +            'wsgi.input': BytesIO(b''),                            
            +        }                                                          
            +        responses = []                                             
            +        def start_response(status, headers):                       
            +            responses.append((status, headers))                    
            +        result = app(environ, start_response)                      
            +        return responses[0][0], b''.join(result)                   
            +                                                                   
            +    # Test integer converter                                       
            +    status, content = make_request('/int/123/')                    
            +    assert status == '200 OK'                                      
            +    assert b'ID: 123 (type: int)' in content                       
            +    print("✓ Integer converter works")                             
            +                                                                   
            +    # Test slug converter                                          
            +    status, content = make_request('/slug/my-test-slug_123/')      
            +    assert status == '200 OK'                                      
