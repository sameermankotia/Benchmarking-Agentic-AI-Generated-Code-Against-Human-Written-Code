                        # For HEAD requests, clear the content but keep headers 
                        if request.method.upper() == '"'"'HEAD'"'"' and method  
            == '"'"'get'"'"':                                                   
                            response.content = '"'"''"'"'                       
                                                                                
                        return response                                         
