            def test_all_converters():                                          
                """Test all URL parameter converters."""                        
                                                                                
                def str_view(request, name):                                    
                    return HttpResponse(f"String: {name}                        
            ({type(name).__name__})")                                           
                                                                                
                def int_view(request, number):                                  
