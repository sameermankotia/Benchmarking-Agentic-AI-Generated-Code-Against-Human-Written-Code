                    return HttpResponse(f"Path: {filepath}                      
            ({type(filepath).__name__})")                                       
                                                                                
                urlpatterns = [                                                 
                    path('"'"'/str/<str:name>/'"'"', str_view),                 
                    path('"'"'/int/<int:number>/'"'"', int_view),               
                    path('"'"'/slug/<slug:slug>/'"'"', slug_view),              
