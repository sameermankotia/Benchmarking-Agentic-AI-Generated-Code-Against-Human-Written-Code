            +        <h1>User Profile #{{ user_id }}</h1>                       
            +        <p>This user has ID: {{ user_id }}</p>                     
            +        <p>Type: {{ user_type }}</p>                               
            +        <a href="/">Back to home</a>                               
            +    </body>                                                        
            +    </html>                                                        
            +    """                                                            
            +    return render_template_string(template, user_id=user_id,       
            user_type=type(user_id).__name__)                                   
            +                                                                   
            +@app.before_request                                                
            +def before_request():                                              
            +    """Set up request context."""                                  
            +    g.request_count = getattr(g, 'request_count', 0) + 1           
            +                                                                   
            +@app.route('/context')                                             
            +def show_context():                                                
            +    """Demonstrate application context."""                         
            +    template = """                                                 
            +    <html>                                                         
            +    <head><title>Context Demo</title></head>                       
