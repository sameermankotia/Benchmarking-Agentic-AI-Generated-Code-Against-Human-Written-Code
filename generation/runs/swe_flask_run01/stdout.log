            class Router:                                                       
                """Main router class that handles URL routing."""               
                                                                                
                def __init__(self):                                             
                    self.map = Map()                                            
                                                                                
                def add_url_rule(self, rule: str, endpoint: str = None,         
            view_func: Callable = None,                                         
                                 methods: List[str] = None):                    
