            +"""                                                                
            +Main Flask application class with WSGI compatibility.              
            +"""                                                                
            +                                                                   
            +import os                                                          
            +import sys                                                         
            +import traceback                                                   
            +from typing import Dict, List, Callable, Optional, Any, Union      
            +                                                                   
            +from .context import AppContext                                    
            +from .request import Request                                       
            +from .response import Response, make_response                      
            +from .routing import Router                                        
            +from .templating import TemplateEngine                             
            +                                                                   
            +                                                                   
            +class Flask:                                                       
            +    """The Flask application class."""                             
            +                                                                   
            +    def __init__(self, import_name: str, template_folder: str =    
            'templates',                                                        
            +                 static_folder: str = 'static'):                   
            +        self.import_name = import_name                             
            +        self.template_folder = template_folder                     
            +        self.static_folder = static_folder                         
            +                                                                   
            +        # Initialize components                                    
            +        self.router = Router()                                     
            +        self.template_engine = TemplateEngine(template_folder)     
            +                                                                   
            +        # Configuration                                            
            +        self.config = {}                                           
            +        self.debug = False                                         
            +                                                                   
            +        # Blueprints                                               
            +        self.blueprints = {}                                       
            +                                                                   
            +        # Error handlers                                           
            +        self.error_handlers = {}                                   
            +                                                                   
            +        # Before/after request handlers                            
            +        self.before_request_funcs = []                             
            +        self.after_request_funcs = []                              
            +                                                                   
            +    def route(self, rule: str, methods: List[str] = None):         
            +        """Decorator for adding routes."""                         
            +        return self.router.route(rule, methods)                    
            +                                                                   
            +    def add_url_rule(self, rule: str, endpoint: str = None,        
            view_func: Callable = None,                                         
            +                     methods: List[str] = None):                   
            +        """Add a URL rule to the application."""                   
            +        self.router.add_url_rule(rule, endpoint, view_func,        
            methods)                                                            
            +                                                                   
            +    def register_blueprint(self, blueprint, **options):            
            +        """Register a blueprint with the application."""           
            +        blueprint.register(self, options)                          
            +        self.blueprints[blueprint.name] = blueprint                
            +                                                                   
            +    def errorhandler(self, code_or_exception):                     
            +        """Decorator for registering error handlers."""            
            +        def decorator(func):                                       
            +            self.error_handlers[code_or_exception] = func          
            +            return func                                            
            +        return decorator                                           
            +                                                                   
            +    def before_request(self, func):                                
            +        """Decorator for registering before request handlers."""   
            +        self.before_request_funcs.append(func)                     
            +        return func                                                
            +                                                                   
            +    def after_request(self, func):                                 
            +        """Decorator for registering after request handlers."""    
            +        self.after_request_funcs.append(func)                      
            +        return func                                                
            +                                                                   
            +    def app_context(self):                                         
            +        """Create an application context."""                       
            +        return AppContext(self)                                    
            +                                                                   
            +    def make_response(self, rv):                                   
            +        """Create a response object from various return values.""" 
            +        return make_response(rv)                                   
            +                                                                   
            +    def handle_exception(self, e):                                 
            +        """Handle an exception during request processing."""       
            +        # Look for a specific error handler                        
            +        handler = self.error_handlers.get(type(e))                 
            +        if handler:                                                
            +            return self.make_response(handler(e))                  
            +                                                                   
            +        # Look for HTTP error handlers                             
            +        if hasattr(e, 'code'):                                     
            +            handler = self.error_handlers.get(e.code)              
            +            if handler:                                            
            +                return self.make_response(handler(e))              
            +                                                                   
            +        # Default error handling                                   
            +        if self.debug:                                             
            +            # Return traceback in debug mode                       
            +            tb = traceback.format_exc()                            
            +            return Response(f"<pre>{tb}</pre>", status=500,        
            mimetype='text/html')                                               
            +        else:                                                      
            +            return Response("Internal Server Error", status=500)   
            +                                                                   
            +    def dispatch_request(self, request):                           
            +        """Dispatch a request to the appropriate handler."""       
            +        try:                                                       
            +            # Run before request handlers                          
            +            for func in self.before_request_funcs:                 
            +                rv = func()                                        
            +                if rv is not None:                                 
            +                    return self.make_response(rv)                  
            +                                                                   
            +            # Match the request to a route                         
            +            view_func, kwargs =                                    
            self.router.match_request(request.path, request.method)             
            +                                                                   
            +            if view_func is None:                                  
            +                # No route found - 404                             
            +                handler = self.error_handlers.get(404)             
            +                if handler:                                        
            +                    return self.make_response(handler())           
            +                return Response("Not Found", status=404)           
            +                                                                   
            +            # Call the view function                               
            +            rv = view_func(**kwargs)                               
            +            response = self.make_response(rv)                      
            +                                                                   
            +            # Run after request handlers                           
            +            for func in self.after_request_funcs:                  
            +                response = func(response) or response              
            +                                                                   
            +            return response                                        
            +                                                                   
            +        except Exception as e:                                     
            +            return self.handle_exception(e)                        
            +                                                                   
            +    def wsgi_app(self, environ, start_response):                   
            +        """WSGI application callable."""                           
            +        request = Request(environ)                                 
            +                                                                   
            +        with AppContext(self):                                     
            +            response = self.dispatch_request(request)              
            +                                                                   
            +        # Start the response                                       
            +        start_response(response.status,                            
            list(response.headers.items()))                                     
            +                                                                   
            +        # Return the response body                                 
            +        return [response.data]                                     
            +                                                                   
            +    def __call__(self, environ, start_response):                   
            +        """Make the app callable as a WSGI application."""         
            +        return self.wsgi_app(environ, start_response)              
            +                                                                   
            +    def run(self, host='127.0.0.1', port=5000, debug=False,        
            **options):                                                         
            +        """Run the application with the built-in development       
            server."""                                                          
            +        self.debug = debug                                         
            +                                                                   
            +        from .server import run_simple                             
            +        run_simple(host, port, self, **options)                    
            +                                                                   
            +                                                                   
            +# Convenience functions                                            
            +def url_for(endpoint: str, **values):                              
            +    """Generate a URL for the given endpoint."""                   
            +    # This is a simplified implementation                          
            +    # In a full implementation, this would reverse the routing     
            +    return f"/{endpoint}"                                          
            +                                                                   
            +                                                                   
            +def redirect(location: str, code: int = 302):                      
            +    """Create a redirect response."""                              
            +    response = Response("", status=code)                           
            +    response.headers['Location'] = location                        
            +    return response                                                
            +                                                                   
            +                                                                   
            +def abort(code: int, description: str = None):                     
            +    """Abort the current request with an HTTP error."""            
            +    class HTTPException(Exception):                                
            +        def __init__(self, code, description=None):                
            +            self.code = code                                       
            +            self.description = description                         
            +                                                                   
            +    raise HTTPException(code, description)                         
            diff --git a/flaskframework/blueprint.py                            
            b/flaskframework/blueprint.py                                       
            new file mode 100644                                                
            index 0000000..4bbff53                                              
            --- /dev/null                                                       
            +++ b/flaskframework/blueprint.py                                   
            @@ -0,0 +1,58 @@                                                    
            +"""                                                                
            +Blueprint-based modular applications with URL prefix inheritance.  
            +"""                                                                
            +                                                                   
            +from typing import List, Callable, Optional                        
            +                                                                   
            +                                                                   
            +class Blueprint:                                                   
            +    """A blueprint for organizing routes and handlers."""          
            +                                                                   
            +    def __init__(self, name: str, import_name: str, url_prefix: str
            = None):                                                            
            +        self.name = name                                           
            +        self.import_name = import_name                             
            +        self.url_prefix = url_prefix                               
            +        self.deferred_functions = []                               
            +                                                                   
            +    def route(self, rule: str, methods: List[str] = None):         
            +        """Decorator for adding routes to the blueprint."""        
            +        def decorator(func):                                       
            +            self.add_url_rule(rule, func.__name__, func, methods)  
            +            return func                                            
            +        return decorator                                           
            +                                                                   
            +    def add_url_rule(self, rule: str, endpoint: str = None,        
            view_func: Callable = None,                                         
            +                     methods: List[str] = None):                   
            +        """Add a URL rule to the blueprint."""                     
            +        if endpoint is None:                                       
            +            endpoint = view_func.__name__ if view_func else rule   
            +                                                                   
            +        # Store the rule for later registration with the app       
            +        self.deferred_functions.append({                           
            +            'rule': rule,                                          
            +            'endpoint': f"{self.name}.{endpoint}",                 
            +            'view_func': view_func,                                
            +            'methods': methods                                     
            +        })                                                         
            +                                                                   
            +    def register(self, app, options):                              
            +        """Register the blueprint with an application."""          
            +        url_prefix = options.get('url_prefix', self.url_prefix)    
            +                                                                   
            +        for deferred in self.deferred_functions:                   
            +            rule = deferred['rule']                                
            +                                                                   
            +            # Apply URL prefix                                     
            +            if url_prefix:                                         
            +                if rule.startswith('/'):                           
            +                    rule = url_prefix.rstrip('/') + rule           
            +                else:                                              
            +                    rule = url_prefix.rstrip('/') + '/' + rule     
            +                                                                   
            +            # Register with the app                                
            +            app.add_url_rule(                                      
            +                rule,                                              
            +                deferred['endpoint'],                              
            +                deferred['view_func'],                             
            +                deferred['methods']                                
            +            )                                                      
            diff --git a/flaskframework/context.py b/flaskframework/context.py  
            new file mode 100644                                                
            index 0000000..5c219e4                                              
            --- /dev/null                                                       
            +++ b/flaskframework/context.py                                     
            @@ -0,0 +1,90 @@                                                    
            +"""                                                                
            +Application context management using thread-local storage.         
            +"""                                                                
            +                                                                   
            +import threading                                                   
            +from typing import Any, Optional                                   
            +                                                                   
            +                                                                   
            +class LocalProxy:                                                  
            +    """A proxy object that forwards operations to a thread-local   
            object."""                                                          
            +                                                                   
            +    def __init__(self, local_func):                                
            +        self._local_func = local_func                              
            +                                                                   
            +    def __getattr__(self, name):                                   
            +        return getattr(self._local_func(), name)                   
            +                                                                   
            +    def __setattr__(self, name, value):                            
            +        if name.startswith('_'):                                   
            +            object.__setattr__(self, name, value)                  
            +        else:                                                      
            +            setattr(self._local_func(), name, value)               
            +                                                                   
            +                                                                   
            +class AppContext:                                                  
            +    """Application context that holds app-specific data."""        
            +                                                                   
            +    def __init__(self, app):                                       
            +        self.app = app                                             
            +        self.g = SimpleNamespace()                                 
            +                                                                   
            +    def __enter__(self):                                           
            +        _app_ctx_stack.push(self)                                  
            +        return self                                                
            +                                                                   
            +    def __exit__(self, exc_type, exc_val, exc_tb):                 
            +        _app_ctx_stack.pop()                                       
            +                                                                   
            +                                                                   
            +class SimpleNamespace:                                             
            +    """Simple object for storing arbitrary attributes."""          
            +    pass                                                           
            +                                                                   
            +                                                                   
            +class LocalStack:                                                  
            +    """A thread-local stack."""                                    
            +                                                                   
            +    def __init__(self):                                            
            +        self._local = threading.local()                            
            +                                                                   
            +    def push(self, obj):                                           
            +        if not hasattr(self._local, 'stack'):                      
            +            self._local.stack = []                                 
            +        self._local.stack.append(obj)                              
            +                                                                   
            +    def pop(self):                                                 
            +        if hasattr(self._local, 'stack') and self._local.stack:    
            +            return self._local.stack.pop()                         
            +        return None                                                
            +                                                                   
            +    @property                                                      
            +    def top(self):                                                 
            +        if hasattr(self._local, 'stack') and self._local.stack:    
            +            return self._local.stack[-1]                           
            +        return None                                                
            +                                                                   
            +                                                                   
            +# Global context stacks                                            
            +_app_ctx_stack = LocalStack()                                      
            +                                                                   
            +                                                                   
            +def _get_current_app():                                            
            +    """Get the current application from the context stack."""      
            +    ctx = _app_ctx_stack.top                                       
            +    if ctx is None:                                                
            +        raise RuntimeError("Working outside of application         
            context")                                                           
            +    return ctx.app                                                 
            +                                                                   
            +                                                                   
            +def _get_g():                                                      
            +    """Get the current g object from the context stack."""         
            +    ctx = _app_ctx_stack.top                                       
            +    if ctx is None:                                                
            +        raise RuntimeError("Working outside of application         
            context")                                                           
            +    return ctx.g                                                   
            +                                                                   
            +                                                                   
            +# Proxy objects for accessing current app and g                    
            +current_app = LocalProxy(_get_current_app)                         
            +g = LocalProxy(_get_g)                                             
            diff --git a/flaskframework/request.py b/flaskframework/request.py  
            new file mode 100644                                                
            index 0000000..886ac0e                                              
            --- /dev/null                                                       
            +++ b/flaskframework/request.py                                     
            @@ -0,0 +1,103 @@                                                   
            +"""                                                                
            +Request object encapsulating HTTP request data.                    
            +"""                                                                
            +                                                                   
            +import io                                                          
            +from urllib.parse import parse_qs, unquote                         
            +                                                                   
            +                                                                   
            +class Request:                                                     
            +    """Request object that encapsulates HTTP request data."""      
            +                                                                   
            +    def __init__(self, environ):                                   
            +        self.environ = environ                                     
            +        self._body = None                                          
            +        self._form = None                                          
            +        self._args = None                                          
            +                                                                   
            +    @property                                                      
            +    def method(self):                                              
            +        """HTTP method (GET, POST, etc.)"""                        
            +        return self.environ.get('REQUEST_METHOD', 'GET')           
            +                                                                   
            +    @property                                                      
            +    def path(self):                                                
            +        """Request path"""                                         
            +        return self.environ.get('PATH_INFO', '/')                  
            +                                                                   
            +    @property                                                      
            +    def headers(self):                                             
            +        """Request headers as a dict-like object"""                
            +        headers = {}                                               
            +        for key, value in self.environ.items():                    
            +            if key.startswith('HTTP_'):                            
            +                # Convert HTTP_HEADER_NAME to Header-Name          
            +                header_name = key[5:].replace('_', '-').title()    
            +                headers[header_name] = value                       
            +            elif key in ('CONTENT_TYPE', 'CONTENT_LENGTH'):        
            +                # Special case for content headers                 
            +                header_name = key.replace('_', '-').title()        
            +                headers[header_name] = value                       
            +        return headers                                             
            +                                                                   
            +    @property                                                      
            +    def query_string(self):                                        
            +        """Raw query string"""                                     
            +        return self.environ.get('QUERY_STRING', '')                
            +                                                                   
            +    @property                                                      
            +    def args(self):                                                
            +        """Parsed query string arguments"""                        
            +        if self._args is None:                                     
            +            self._args = parse_qs(self.query_string,               
            keep_blank_values=True)                                             
            +            # Convert lists to single values for convenience       
            +            for key, value in self._args.items():                  
            +                if len(value) == 1:                                
            +                    self._args[key] = value[0]                     
            +        return self._args                                          
            +                                                                   
            +    @property                                                      
            +    def body(self):                                                
            +        """Request body as bytes"""                                
            +        if self._body is None:                                     
            +            try:                                                   
            +                content_length =                                   
            int(self.environ.get('CONTENT_LENGTH', 0))                          
            +            except ValueError:                                     
            +                content_length = 0                                 
            +                                                                   
            +            if content_length > 0:                                 
            +                self._body =                                       
            self.environ['wsgi.input'].read(content_length)                     
            +            else:                                                  
            +                self._body = b''                                   
            +        return self._body                                          
            +                                                                   
            +    @property                                                      
            +    def data(self):                                                
            +        """Request body as string"""                               
            +        return self.body.decode('utf-8', errors='replace')         
            +                                                                   
            +    @property                                                      
            +    def form(self):                                                
            +        """Parsed form data (for POST requests)"""                 
            +        if self._form is None:                                     
            +            content_type = self.environ.get('CONTENT_TYPE', '')    
            +            if                                                     
            content_type.startswith('application/x-www-form-urlencoded'):       
            +                self._form = parse_qs(self.data,                   
            keep_blank_values=True)                                             
            +                # Convert lists to single values for convenience   
            +                for key, value in self._form.items():              
            +                    if len(value) == 1:                            
            +                        self._form[key] = value[0]                 
            +            else:                                                  
            +                self._form = {}                                    
            +        return self._form                                          
            +                                                                   
            +    def get_json(self):                                            
            +        """Parse JSON body"""                                      
            +        import json                                                
            +        content_type = self.environ.get('CONTENT_TYPE', '')        
            +        if content_type.startswith('application/json'):            
            +            try:                                                   
            +                return json.loads(self.data)                       
            +            except json.JSONDecodeError:                           
            +                return None                                        
            +        return None                                                
            diff --git a/flaskframework/response.py b/flaskframework/response.py
            new file mode 100644                                                
            index 0000000..ac28e91                                              
            --- /dev/null                                                       
            +++ b/flaskframework/response.py                                    
            @@ -0,0 +1,105 @@                                                   
            +"""                                                                
            +Response object with status code, headers, and body.               
            +"""                                                                
            +                                                                   
            +import json                                                        
            +from typing import Union, Dict, List, Tuple, Any                   
            +                                                                   
            +                                                                   
            +class Response:                                                    
            +    """Response object that encapsulates HTTP response data."""    
            +                                                                   
            +    def __init__(self, response=None, status=200, headers=None,    
            mimetype='text/html'):                                              
            +        if isinstance(response, str):                              
            +            self.data = response.encode('utf-8')                   
            +        elif isinstance(response, bytes):                          
            +            self.data = response                                   
            +        elif response is None:                                     
            +            self.data = b''                                        
            +        else:                                                      
            +            # Convert other types to JSON                          
            +            self.data = json.dumps(response).encode('utf-8')       
            +            mimetype = 'application/json'                          
            +                                                                   
            +        self.status_code = status                                  
            +        self.headers = dict(headers or {})                         
            +                                                                   
            +        # Set content type if not already set                      
            +        if 'Content-Type' not in self.headers:                     
            +            self.headers['Content-Type'] = mimetype                
            +                                                                   
            +        # Set content length                                       
            +        self.headers['Content-Length'] = str(len(self.data))       
            +                                                                   
            +    @property                                                      
            +    def status(self):                                              
            +        """Status line for HTTP response"""                        
            +        status_messages = {                                        
            +            200: 'OK',                                             
            +            201: 'Created',                                        
            +            204: 'No Content',                                     
            +            301: 'Moved Permanently',                              
            +            302: 'Found',                                          
            +            304: 'Not Modified',                                   
            +            400: 'Bad Request',                                    
            +            401: 'Unauthorized',                                   
            +            403: 'Forbidden',                                      
            +            404: 'Not Found',                                      
            +            405: 'Method Not Allowed',                             
            +            500: 'Internal Server Error',                          
            +            502: 'Bad Gateway',                                    
            +            503: 'Service Unavailable',                            
            +        }                                                          
            +        message = status_messages.get(self.status_code, 'Unknown') 
            +        return f"{self.status_code} {message}"                     
            +                                                                   
            +    def set_cookie(self, key, value='', max_age=None, expires=None,
            path='/',                                                           
            +                   domain=None, secure=False, httponly=False):     
            +        """Set a cookie"""                                         
            +        cookie = f"{key}={value}; Path={path}"                     
            +                                                                   
            +        if max_age is not None:                                    
            +            cookie += f"; Max-Age={max_age}"                       
            +                                                                   
            +        if expires is not None:                                    
            +            cookie += f"; Expires={expires}"                       
            +                                                                   
            +        if domain is not None:                                     
            +            cookie += f"; Domain={domain}"                         
            +                                                                   
            +        if secure:                                                 
            +            cookie += "; Secure"                                   
            +                                                                   
            +        if httponly:                                               
            +            cookie += "; HttpOnly"                                 
            +                                                                   
            +        # Handle multiple Set-Cookie headers                       
            +        if 'Set-Cookie' in self.headers:                           
            +            if isinstance(self.headers['Set-Cookie'], list):       
            +                self.headers['Set-Cookie'].append(cookie)          
            +            else:                                                  
            +                self.headers['Set-Cookie'] =                       
            [self.headers['Set-Cookie'], cookie]                                
            +        else:                                                      
            +            self.headers['Set-Cookie'] = cookie                    
            +                                                                   
            +    def __iter__(self):                                            
            +        """Make response iterable for WSGI"""                      
            +        yield self.data                                            
            +                                                                   
            +                                                                   
            +def make_response(rv, status=None, headers=None):                  
            +    """Create a Response object from various return values"""      
            +    if isinstance(rv, Response):                                   
            +        if status is not None:                                     
            +            rv.status_code = status                                
            +        if headers is not None:                                    
            +            rv.headers.update(headers)                             
            +        return rv                                                  
            +                                                                   
            +    if isinstance(rv, tuple):                                      
            +        if len(rv) == 2:                                           
            +            rv, status = rv                                        
            +        elif len(rv) == 3:                                         
            +            rv, status, headers = rv                               
            +                                                                   
            +    return Response(rv, status or 200, headers)                    
            diff --git a/flaskframework/routing.py b/flaskframework/routing.py  
            new file mode 100644                                                
            index 0000000..dd492a1                                              
            --- /dev/null                                                       
            +++ b/flaskframework/routing.py                                     
            @@ -0,0 +1,169 @@                                                   
            +"""                                                                
            +URL routing with variable segments and HTTP method filtering.      
            +"""                                                                
            +                                                                   
            +import re                                                          
            +from typing import Dict, List, Tuple, Callable, Optional, Any      
            +                                                                   
            +                                                                   
            +class Rule:                                                        
            +    """A URL rule that can match against request paths."""         
            +                                                                   
            +    def __init__(self, rule: str, endpoint: str, methods: List[str]
            = None):                                                            
            +        self.rule = rule                                           
            +        self.endpoint = endpoint                                   
            +        self.methods = set(methods or ['GET'])                     
            +                                                                   
            +        # Convert Flask-style route to regex                       
            +        self.regex, self.variables = self._compile_rule(rule)      
            +                                                                   
            +        # Calculate priority (higher priority = more specific)     
            +        self.priority = self._calculate_priority(rule)             
            +                                                                   
            +    def _compile_rule(self, rule: str) -> Tuple[re.Pattern,        
            List[str]]:                                                         
            +        """Convert a Flask-style route pattern to a regex."""      
            +        variables = []                                             
            +                                                                   
            +        # Find all variable segments like <name> or <int:name>     
            +        def replace_variable(match):                               
            +            full_match = match.group(0)                            
            +            var_spec = match.group(1)                              
            +                                                                   
            +            if ':' in var_spec:                                    
            +                converter, name = var_spec.split(':', 1)           
            +                if converter == 'int':                             
            +                    pattern = r'(\d+)'                             
            +                elif converter == 'float':                         
            +                    pattern = r'(\d+\.?\d*)'                       
            +                elif converter == 'path':                          
            +                    pattern = r'([^/]+(?:/[^/]+)*)'                
            +                else:                                              
            +                    pattern = r'([^/]+)'                           
            +            else:                                                  
            +                name = var_spec                                    
            +                pattern = r'([^/]+)'                               
            +                                                                   
            +            variables.append(name)                                 
            +            return pattern                                         
            +                                                                   
            +        # Replace variable segments                                
            +        pattern = re.sub(r'<([^>]+)>', replace_variable, rule)     
            +                                                                   
            +        # Escape other regex special characters                    
            +        pattern = pattern.replace('.', r'\.')                      
            +                                                                   
            +        # Ensure exact match                                       
            +        pattern = f'^{pattern}$'                                   
            +                                                                   
            +        return re.compile(pattern), variables                      
            +                                                                   
            +    def match(self, path: str) -> Optional[Dict[str, Any]]:        
            +        """Match a path against this rule and return variables.""" 
            +        match = self.regex.match(path)                             
            +        if not match:                                              
            +            return None                                            
            +                                                                   
            +        # Extract variables                                        
            +        values = {}                                                
            +        for i, name in enumerate(self.variables):                  
            +            value = match.group(i + 1)                             
            +            # Try to convert to appropriate type                   
            +            try:                                                   
            +                # Check if it's an integer                         
            +                if value.isdigit():                                
            +                    values[name] = int(value)                      
            +                # Check if it's a float                            
            +                elif '.' in value and value.replace('.',           
            '').isdigit():                                                      
            +                    values[name] = float(value)                    
            +                else:                                              
            +                    values[name] = value                           
            +            except ValueError:                                     
            +                values[name] = value                               
            +                                                                   
            +        return values                                              
            +                                                                   
            +    def _calculate_priority(self, rule: str) -> int:               
            +        """Calculate rule priority. Higher number = higher priority
            (more specific)."""                                                 
            +        priority = 0                                               
            +                                                                   
            +        # Static segments get higher priority than variable        
            segments                                                            
            +        segments = rule.split('/')                                 
            +        for segment in segments:                                   
            +            if segment and not segment.startswith('<'):            
            +                priority += 100  # Static segment                  
            +            elif segment.startswith('<') and ':' in segment:       
            +                # Typed variable segments get higher priority than 
            generic ones                                                        
            +                converter = segment.split(':')[0][1:]              
            +                if converter in ('int', 'float'):                  
            +                    priority += 50  # Typed variable               
            +                else:                                              
            +                    priority += 25  # Other typed variable         
            +            elif segment.startswith('<'):                          
            +                priority += 10  # Generic variable                 
            +                                                                   
            +        # Longer rules get slightly higher priority                
            +        priority += len(segments)                                  
            +                                                                   
            +        return priority                                            
            +                                                                   
            +                                                                   
            +class Map:                                                         
            +    """URL map that holds all routing rules."""                    
            +                                                                   
            +    def __init__(self):                                            
            +        self.rules: List[Rule] = []                                
            +        self.endpoints: Dict[str, Callable] = {}                   
            +                                                                   
            +    def add(self, rule: Rule):                                     
            +        """Add a rule to the map."""                               
            +        self.rules.append(rule)                                    
            +                                                                   
            +    def bind_endpoint(self, endpoint: str, view_func: Callable):   
            +        """Bind a view function to an endpoint."""                 
            +        self.endpoints[endpoint] = view_func                       
            +                                                                   
            +    def match(self, path: str, method: str = 'GET') ->             
            Tuple[Optional[Callable], Dict[str, Any]]:                          
            +        """Match a path and method against all rules."""           
            +        # Sort rules by priority (highest first) for matching      
            +        sorted_rules = sorted(self.rules, key=lambda r: r.priority,
            reverse=True)                                                       
            +                                                                   
            +        for rule in sorted_rules:                                  
            +            if method not in rule.methods:                         
            +                continue                                           
            +                                                                   
            +            variables = rule.match(path)                           
            +            if variables is not None:                              
            +                view_func = self.endpoints.get(rule.endpoint)      
            +                return view_func, variables                        
            +                                                                   
            +        return None, {}                                            
            +                                                                   
            +                                                                   
            +class Router:                                                      
            +    """Main router class that handles URL routing."""              
            +                                                                   
            +    def __init__(self):                                            
            +        self.map = Map()                                           
            +                                                                   
            +    def add_url_rule(self, rule: str, endpoint: str = None,        
            view_func: Callable = None,                                         
            +                     methods: List[str] = None):                   
            +        """Add a URL rule to the router."""                        
            +        if endpoint is None:                                       
            +            endpoint = view_func.__name__ if view_func else rule   
            +                                                                   
            +        url_rule = Rule(rule, endpoint, methods)                   
            +        self.map.add(url_rule)                                     
            +                                                                   
            +        if view_func is not None:                                  
            +            self.map.bind_endpoint(endpoint, view_func)            
            +                                                                   
            +    def route(self, rule: str, methods: List[str] = None):         
            +        """Decorator for adding routes."""                         
            +        def decorator(func):                                       
            +            self.add_url_rule(rule, func.__name__, func, methods)  
            +            return func                                            
            +        return decorator                                           
            +                                                                   
            +    def match_request(self, path: str, method: str) ->             
            Tuple[Optional[Callable], Dict[str, Any]]:                          
            +        """Match a request against all rules."""                   
            +        return self.map.match(path, method)                        
            diff --git a/flaskframework/server.py b/flaskframework/server.py    
            new file mode 100644                                                
            index 0000000..993b675                                              
            --- /dev/null                                                       
            +++ b/flaskframework/server.py                                      
            @@ -0,0 +1,61 @@                                                    
            +"""                                                                
            +Built-in development server.                                       
            +"""                                                                
            +                                                                   
            +import socket                                                      
            +import threading                                                   
            +from wsgiref.simple_server import make_server, WSGIServer,         
            WSGIRequestHandler                                                  
            +from typing import Callable                                        
            +                                                                   
            +                                                                   
            +class QuietWSGIRequestHandler(WSGIRequestHandler):                 
            +    """A WSGI request handler that can be made quiet."""           
            +                                                                   
            +    def log_message(self, format, *args):                          
            +        """Override to control logging."""                         
            +        if getattr(self.server, 'quiet', False):                   
            +            return                                                 
            +        super().log_message(format, *args)                         
            +                                                                   
            +                                                                   
            +def run_simple(hostname: str, port: int, application: Callable,    
            +               use_reloader: bool = False, use_debugger: bool =    
            False,                                                              
            +               use_evalex: bool = True, extra_files=None,          
            reloader_interval: int = 1,                                         
            +               reloader_type: str = 'auto', threaded: bool = False,
            +               processes: int = 1, request_handler=None,           
            static_files=None,                                                  
            +               passthrough_errors: bool = False, ssl_context=None, 
            quiet: bool = False):                                               
            +    """Run a WSGI application with a simple development server.""" 
            +                                                                   
            +    if request_handler is None:                                    
            +        request_handler = QuietWSGIRequestHandler                  
            +                                                                   
            +    # Create the server                                            
            +    server = make_server(hostname, port, application,              
            +                        server_class=WSGIServer,                   
            +                        handler_class=request_handler)             
            +                                                                   
            +    # Set quiet mode                                               
            +    server.quiet = quiet                                           
            +                                                                   
            +    print(f" * Running on http://{hostname}:{port}/")              
            +    print(" * Press CTRL+C to quit")                               
            +                                                                   
            +    try:                                                           
            +        if threaded:                                               
            +            # Run in threaded mode                                 
            +            server_thread =                                        
            threading.Thread(target=server.serve_forever)                       
            +            server_thread.daemon = True                            
            +            server_thread.start()                                  
            +                                                                   
            +            try:                                                   
            +                while True:                                        
            +                    threading.Event().wait(1)                      
            +            except KeyboardInterrupt:                              
            +                pass                                               
            +        else:                                                      
            +            server.serve_forever()                                 
            +    except KeyboardInterrupt:                                      
            +        print("\n * Shutting down...")                             
            +    finally:                                                       
            +        server.shutdown()                                          
            +        server.server_close()                                      
            diff --git a/flaskframework/templating.py                           
            b/flaskframework/templating.py                                      
            new file mode 100644                                                
            index 0000000..666e3cc                                              
            --- /dev/null                                                       
            +++ b/flaskframework/templating.py                                  
            @@ -0,0 +1,104 @@                                                   
            +"""                                                                
            +Jinja2 template rendering integrated with the application context. 
            +"""                                                                
            +                                                                   
            +import os                                                          
            +from typing import Dict, Any, Optional                             
            +                                                                   
            +try:                                                               
            +    from jinja2 import Environment, FileSystemLoader,              
            select_autoescape                                                   
            +    HAS_JINJA2 = True                                              
            +except ImportError:                                                
            +    HAS_JINJA2 = False                                             
            +                                                                   
            +                                                                   
            +class SimpleTemplateEngine:                                        
            +    """Simple template engine for basic variable substitution."""  
            +                                                                   
            +    def render_template_string(self, source: str, **context) ->    
            str:                                                                
            +        """Render a template string with simple variable           
            substitution."""                                                    
            +        import re                                                  
            +                                                                   
            +        def replace_var(match):                                    
            +            var_name = match.group(1).strip()                      
            +            # Handle nested attributes like user.name              
            +            if '.' in var_name:                                    
            +                parts = var_name.split('.')                        
            +                value = context                                    
            +                for part in parts:                                 
            +                    if isinstance(value, dict):                    
            +                        value = value.get(part, '')                
            +                    else:                                          
            +                        value = getattr(value, part, '')           
            +                return str(value)                                  
            +            else:                                                  
            +                return str(context.get(var_name, ''))              
            +                                                                   
            +        # Replace {{ variable }} patterns                          
            +        result = re.sub(r'\{\{\s*([^}]+)\s*\}\}', replace_var,     
            source)                                                             
            +        return result                                              
            +                                                                   
            +    def render_template(self, template_name: str, **context) ->    
            str:                                                                
            +        """Render a template file."""                              
            +        template_path = os.path.join(self.template_folder,         
            template_name)                                                      
            +        try:                                                       
            +            with open(template_path, 'r') as f:                    
            +                source = f.read()                                  
            +            return self.render_template_string(source, **context)  
            +        except FileNotFoundError:                                  
            +            return f"Template {template_name} not found"           
            +                                                                   
            +                                                                   
            +class TemplateEngine:                                              
            +    """Template engine wrapper for Jinja2 with fallback."""        
            +                                                                   
            +    def __init__(self, template_folder: str = 'templates'):        
            +        self.template_folder = template_folder                     
            +        self._env = None                                           
            +        self._simple_engine = None                                 
            +                                                                   
            +    @property                                                      
            +    def env(self):                                                 
            +        """Lazy-load the Jinja2 environment."""                    
            +        if self._env is None:                                      
            +            if not HAS_JINJA2:                                     
            +                # Use simple template engine as fallback           
            +                if self._simple_engine is None:                    
            +                    self._simple_engine = SimpleTemplateEngine()   
            +                    self._simple_engine.template_folder =          
            self.template_folder                                                
            +                return self._simple_engine                         
            +                                                                   
            +            loader = FileSystemLoader(self.template_folder)        
            +            self._env = Environment(                               
            +                loader=loader,                                     
            +                autoescape=select_autoescape(['html', 'xml'])      
            +            )                                                      
            +        return self._env                                           
            +                                                                   
            +    def render_template(self, template_name: str, **context) ->    
            str:                                                                
            +        """Render a template with the given context."""            
            +        if HAS_JINJA2:                                             
            +            template = self.env.get_template(template_name)        
            +            return template.render(**context)                      
            +        else:                                                      
            +            return self.env.render_template(template_name,         
            **context)                                                          
            +                                                                   
            +    def render_template_string(self, source: str, **context) ->    
            str:                                                                
            +        """Render a template from a string."""                     
            +        if HAS_JINJA2:                                             
            +            template = self.env.from_string(source)                
            +            return template.render(**context)                      
            +        else:                                                      
            +            return self.env.render_template_string(source,         
            **context)                                                          
            +                                                                   
            +                                                                   
            +def render_template(template_name: str, **context) -> str:         
            +    """Render a template using the current app's template          
            engine."""                                                          
            +    from .context import current_app                               
            +    return                                                         
            current_app.template_engine.render_template(template_name,          
            **context)                                                          
            +                                                                   
            +                                                                   
            +def render_template_string(source: str, **context) -> str:         
            +    """Render a template string using the current app's template   
            engine."""                                                          
            +    from .context import current_app                               
            +    return                                                         
            current_app.template_engine.render_template_string(source,          
            **context)                                                          
