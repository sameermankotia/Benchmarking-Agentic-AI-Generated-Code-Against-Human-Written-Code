            +"""                                                                
            +Main Flask application class with WSGI compatibility.              
            +"""                                                                
            +                                                                   
            +import os                                                          
            +import sys                                                         
            +from typing import Dict, List, Callable, Optional, Any, Tuple      
            +from .context import AppContext                                    
            +from .request import Request                                       
            +from .response import Response, make_response                      
            +from .routing import Map, Rule                                     
            +from .templating import render_template, render_template_string    
            +                                                                   
            +                                                                   
            +class Flask:                                                       
            +    """A WSGI-compatible micro web framework."""                   
            +                                                                   
            +    def __init__(self, import_name: str, template_folder: str =    
            'templates'):                                                       
            +        self.import_name = import_name                             
            +        self.template_folder = template_folder                     
            +                                                                   
            +        # URL routing                                              
            +        self.url_map = Map()                                       
            +                                                                   
            +        # Error handlers                                           
            +        self.error_handlers: Dict[int, Callable] = {}              
            +                                                                   
            +        # Before/after request handlers                            
            +        self.before_request_funcs: List[Callable] = []             
            +        self.after_request_funcs: List[Callable] = []              
            +                                                                   
            +        # Configuration                                            
            +        self.config = {}                                           
            +                                                                   
            +        # Debug mode                                               
            +        self.debug = False                                         
            +                                                                   
            +    def route(self, rule: str, **options):                         
            +        """Decorator for adding routes."""                         
            +        def decorator(f):                                          
            +            endpoint = options.pop('endpoint', f.__name__)         
            +            methods = options.pop('methods', ['GET'])              
            +            self.add_url_rule(rule, endpoint, f, methods=methods)  
            +            return f                                               
            +        return decorator                                           
            +                                                                   
            +    def add_url_rule(self, rule: str, endpoint: str, view_func:    
            Callable, methods: List[str] = None):                               
            +        """Add a URL rule."""                                      
            +        if methods is None:                                        
            +            methods = ['GET']                                      
            +                                                                   
            +        rule_obj = Rule(rule, endpoint, methods)                   
            +        self.url_map.add(rule_obj, view_func)                      
            +                                                                   
            +    def errorhandler(self, code: int):                             
            +        """Decorator for registering error handlers."""            
            +        def decorator(f):                                          
            +            self.error_handlers[code] = f                          
            +            return f                                               
            +        return decorator                                           
            +                                                                   
            +    def before_request(self, f):                                   
            +        """Decorator for registering before request handlers."""   
            +        self.before_request_funcs.append(f)                        
            +        return f                                                   
            +                                                                   
            +    def after_request(self, f):                                    
            +        """Decorator for registering after request handlers."""    
            +        self.after_request_funcs.append(f)                         
            +        return f                                                   
            +                                                                   
            +    def register_blueprint(self, blueprint, **options):            
            +        """Register a blueprint with the application."""           
            +        blueprint.register(self, options)                          
            +                                                                   
            +    def make_response(self, rv) -> Response:                       
            +        """Convert return value to Response object."""             
            +        return make_response(rv)                                   
            +                                                                   
            +    def handle_exception(self, e: Exception) -> Response:          
            +        """Handle exceptions and return error responses."""        
            +        if isinstance(e, HTTPException):                           
            +            return self.handle_http_exception(e)                   
            +                                                                   
            +        # For other exceptions, return 500 error                   
            +        if 500 in self.error_handlers:                             
            +            return self.make_response(self.error_handlers[500](e)) 
            +                                                                   
            +        if self.debug:                                             
            +            # In debug mode, show the full traceback               
            +            import traceback                                       
            +            tb = traceback.format_exc()                            
            +            return Response(f"<h1>Internal Server                  
            Error</h1><pre>{tb}</pre>",                                         
            +                          status=500, content_type='text/html')    
            +        else:                                                      
            +            return Response("Internal Server Error", status=500)   
            +                                                                   
            +    def handle_http_exception(self, e) -> Response:                
            +        """Handle HTTP exceptions."""                              
            +        code = getattr(e, 'code', 500)                             
            +        if code in self.error_handlers:                            
            +            return self.make_response(self.error_handlers[code](e))
            +                                                                   
            +        return Response(str(e), status=code)                       
            +                                                                   
            +    def dispatch_request(self, request: Request) -> Response:      
            +        """Dispatch the request to the appropriate view            
            function."""                                                        
            +        try:                                                       
            +            # Run before request handlers                          
            +            for func in self.before_request_funcs:                 
            +                rv = func()                                        
            +                if rv is not None:                                 
            +                    return self.make_response(rv)                  
            +                                                                   
            +            # Find matching route                                  
            +            view_func, values = self.url_map.match(request.path,   
            request.method)                                                     
            +                                                                   
            +            if view_func is None:                                  
            +                raise HTTPException("Not Found", 404)              
            +                                                                   
            +            # Call view function with URL variables                
            +            if values:                                             
            +                rv = view_func(**values)                           
            +            else:                                                  
            +                rv = view_func()                                   
            +                                                                   
            +            response = self.make_response(rv)                      
            +                                                                   
            +            # Run after request handlers                           
            +            for func in self.after_request_funcs:                  
            +                response = func(response) or response              
            +                                                                   
            +            return response                                        
            +                                                                   
            +        except HTTPException as e:                                 
            +            return self.handle_http_exception(e)                   
            +        except Exception as e:                                     
            +            return self.handle_exception(e)                        
            +                                                                   
            +    def wsgi_app(self, environ, start_response):                   
            +        """WSGI application callable."""                           
            +        request = Request(environ)                                 
            +                                                                   
            +        with AppContext(self):                                     
            +            response = self.dispatch_request(request)              
            +                                                                   
            +        start_response(response.status,                            
            response.get_wsgi_headers())                                        
            +        return iter(response)                                      
            +                                                                   
            +    def __call__(self, environ, start_response):                   
            +        """Make the app callable for WSGI."""                      
            +        return self.wsgi_app(environ, start_response)              
            +                                                                   
            +    def run(self, host='127.0.0.1', port=5000, debug=None):        
            +        """Run the application with a built-in development         
            server."""                                                          
            +        if debug is not None:                                      
            +            self.debug = debug                                     
            +                                                                   
            +        from wsgiref.simple_server import make_server              
            +                                                                   
            +        print(f" * Running on http://{host}:{port}/")              
            +        if self.debug:                                             
            +            print(" * Debug mode: on")                             
            +                                                                   
            +        server = make_server(host, port, self)                     
            +        try:                                                       
            +            server.serve_forever()                                 
            +        except KeyboardInterrupt:                                  
            +            print("\n * Shutting down...")                         
            +                                                                   
            +                                                                   
            +class HTTPException(Exception):                                    
            +    """Base class for HTTP exceptions."""                          
            +                                                                   
            +    def __init__(self, description: str, code: int = 500):         
            +        self.description = description                             
            +        self.code = code                                           
            +        super().__init__(description)                              
            +                                                                   
            +    def __str__(self):                                             
            +        return self.description                                    
            diff --git a/flaskframework/blueprints.py                           
            b/flaskframework/blueprints.py                                      
            new file mode 100644                                                
            index 0000000..ffcc5da                                              
            --- /dev/null                                                       
            +++ b/flaskframework/blueprints.py                                  
            @@ -0,0 +1,62 @@                                                    
            +"""                                                                
            +Blueprint-based modular applications with URL prefix inheritance.  
            +"""                                                                
            +                                                                   
            +from typing import List, Callable, Optional, Dict, Any             
            +from .routing import Rule                                          
            +                                                                   
            +                                                                   
            +class Blueprint:                                                   
            +    """A blueprint for organizing related routes and               
            functionality."""                                                   
            +                                                                   
            +    def __init__(self, name: str, import_name: str, url_prefix:    
            Optional[str] = None):                                              
            +        self.name = name                                           
            +        self.import_name = import_name                             
            +        self.url_prefix = url_prefix                               
            +        self.deferred_functions: List[Callable] = []               
            +                                                                   
            +    def route(self, rule: str, **options):                         
            +        """Decorator for adding routes to the blueprint."""        
            +        def decorator(f):                                          
            +            endpoint = options.pop('endpoint', f.__name__)         
            +            methods = options.pop('methods', ['GET'])              
            +                                                                   
            +            def register_rule(app):                                
            +                # Apply URL prefix if set                          
            +                full_rule = rule                                   
            +                if self.url_prefix:                                
            +                    # Remove trailing slash from prefix and leading
            slash from rule if both exist                                       
            +                    prefix = self.url_prefix.rstrip('/')           
            +                    rule_part = rule.lstrip('/')                   
            +                    full_rule = f"{prefix}/{rule_part}" if         
            rule_part else prefix                                               
            +                                                                   
            +                # Create endpoint name with blueprint prefix       
            +                full_endpoint = f"{self.name}.{endpoint}"          
            +                                                                   
            +                app.add_url_rule(full_rule, full_endpoint, f,      
            methods=methods)                                                    
            +                                                                   
            +            self.deferred_functions.append(register_rule)          
            +            return f                                               
            +        return decorator                                           
            +                                                                   
            +    def add_url_rule(self, rule: str, endpoint: str, view_func:    
            Callable, methods: List[str] = None):                               
            +        """Add a URL rule to the blueprint."""                     
            +        def register_rule(app):                                    
            +            # Apply URL prefix if set                              
            +            full_rule = rule                                       
            +            if self.url_prefix:                                    
            +                prefix = self.url_prefix.rstrip('/')               
            +                rule_part = rule.lstrip('/')                       
            +                full_rule = f"{prefix}/{rule_part}" if rule_part   
            else prefix                                                         
            +                                                                   
            +            # Create endpoint name with blueprint prefix           
            +            full_endpoint = f"{self.name}.{endpoint}"              
            +                                                                   
            +            app.add_url_rule(full_rule, full_endpoint, view_func,  
            methods=methods)                                                    
            +                                                                   
            +        self.deferred_functions.append(register_rule)              
            +                                                                   
            +    def register(self, app, options=None):                         
            +        """Register the blueprint with an application."""          
            +        for func in self.deferred_functions:                       
            +            func(app)                                              
            diff --git a/flaskframework/context.py b/flaskframework/context.py  
            new file mode 100644                                                
            index 0000000..bd5df27                                              
            --- /dev/null                                                       
            +++ b/flaskframework/context.py                                     
            @@ -0,0 +1,86 @@                                                    
            +"""                                                                
            +Application context management using thread-local storage.         
            +"""                                                                
            +                                                                   
            +import threading                                                   
            +from typing import Any, Optional                                   
            +                                                                   
            +                                                                   
            +class LocalProxy:                                                  
            +    """A proxy to a thread-local object."""                        
            +                                                                   
            +    def __init__(self, local, name):                               
            +        object.__setattr__(self, '_LocalProxy__local', local)      
            +        object.__setattr__(self, '_LocalProxy__name', name)        
            +                                                                   
            +    def _get_current_object(self):                                 
            +        try:                                                       
            +            ctx = self.__local.top                                 
            +            if ctx is None:                                        
            +                raise RuntimeError(f'Working outside of application
            context')                                                           
            +            return getattr(ctx, self.__name)                       
            +        except AttributeError:                                     
            +            raise RuntimeError(f'Working outside of application    
            context')                                                           
            +                                                                   
            +    def __getattr__(self, name):                                   
            +        return getattr(self._get_current_object(), name)           
            +                                                                   
            +    def __setattr__(self, name, value):                            
            +        setattr(self._get_current_object(), name, value)           
            +                                                                   
            +    def __delattr__(self, name):                                   
            +        delattr(self._get_current_object(), name)                  
            +                                                                   
            +                                                                   
            +class AppContext:                                                  
            +    """Application context that holds app-specific data."""        
            +                                                                   
            +    def __init__(self, app):                                       
            +        self.app = app                                             
            +        self.g = G()                                               
            +                                                                   
            +    def __enter__(self):                                           
            +        _app_ctx_stack.push(self)                                  
            +        return self                                                
            +                                                                   
            +    def __exit__(self, exc_type, exc_val, exc_tb):                 
            +        _app_ctx_stack.pop()                                       
            +                                                                   
            +                                                                   
            +class G:                                                           
            +    """A namespace object that can store data during an application
            context."""                                                         
            +    pass                                                           
            +                                                                   
            +                                                                   
            +class LocalStack:                                                  
            +    """A thread-local stack."""                                    
            +                                                                   
            +    def __init__(self):                                            
            +        self._local = threading.local()                            
            +                                                                   
            +    def push(self, obj):                                           
            +        stack = getattr(self._local, 'stack', None)                
            +        if stack is None:                                          
            +            self._local.stack = stack = []                         
            +        stack.append(obj)                                          
            +                                                                   
            +    def pop(self):                                                 
            +        stack = getattr(self._local, 'stack', None)                
            +        if stack is None or not stack:                             
            +            return None                                            
            +        return stack.pop()                                         
            +                                                                   
            +    @property                                                      
            +    def top(self):                                                 
            +        stack = getattr(self._local, 'stack', None)                
            +        if stack is None or not stack:                             
            +            return None                                            
            +        return stack[-1]                                           
            +                                                                   
            +                                                                   
            +# Global context stacks                                            
            +_app_ctx_stack = LocalStack()                                      
            +                                                                   
            +# Proxies that provide access to current app and g                 
            +current_app = LocalProxy(_app_ctx_stack, 'app')                    
            +g = LocalProxy(_app_ctx_stack, 'g')                                
            diff --git a/flaskframework/request.py b/flaskframework/request.py  
            new file mode 100644                                                
            index 0000000..5fe5974                                              
            --- /dev/null                                                       
            +++ b/flaskframework/request.py                                     
            @@ -0,0 +1,100 @@                                                   
            +"""                                                                
            +Request object that encapsulates HTTP request data.                
            +"""                                                                
            +                                                                   
            +import io                                                          
            +from urllib.parse import parse_qs, unquote                         
            +from typing import Dict, Any, Optional                             
            +                                                                   
            +                                                                   
            +class Request:                                                     
            +    """Encapsulates HTTP request data including method, path,      
            headers, query string, and body."""                                 
            +                                                                   
            +    def __init__(self, environ):                                   
            +        self.environ = environ                                     
            +        self._body = None                                          
            +        self._json = None                                          
            +                                                                   
            +    @property                                                      
            +    def method(self) -> str:                                       
            +        """HTTP method (GET, POST, etc.)"""                        
            +        return self.environ.get('REQUEST_METHOD', 'GET')           
            +                                                                   
            +    @property                                                      
            +    def path(self) -> str:                                         
            +        """Request path"""                                         
            +        return self.environ.get('PATH_INFO', '/')                  
            +                                                                   
            +    @property                                                      
            +    def query_string(self) -> str:                                 
            +        """Raw query string"""                                     
            +        return self.environ.get('QUERY_STRING', '')                
            +                                                                   
            +    @property                                                      
            +    def args(self) -> Dict[str, Any]:                              
            +        """Parsed query string arguments"""                        
            +        if not hasattr(self, '_args'):                             
            +            self._args = {}                                        
            +            if self.query_string:                                  
            +                parsed = parse_qs(self.query_string,               
            keep_blank_values=True)                                             
            +                # Convert lists to single values for simplicity    
            +                for key, values in parsed.items():                 
            +                    self._args[key] = values[0] if len(values) == 1
            else values                                                         
            +        return self._args                                          
            +                                                                   
            +    @property                                                      
            +    def headers(self) -> Dict[str, str]:                           
            +        """HTTP headers"""                                         
            +        if not hasattr(self, '_headers'):                          
            +            self._headers = {}                                     
            +            for key, value in self.environ.items():                
            +                if key.startswith('HTTP_'):                        
            +                    # Convert HTTP_CONTENT_TYPE to Content-Type    
            +                    header_name = key[5:].replace('_', '-').title()
            +                    self._headers[header_name] = value             
            +                elif key in ('CONTENT_TYPE', 'CONTENT_LENGTH'):    
            +                    # Special case for content headers             
            +                    header_name = key.replace('_', '-').title()    
            +                    self._headers[header_name] = value             
            +        return self._headers                                       
            +                                                                   
            +    @property                                                      
            +    def content_type(self) -> Optional[str]:                       
            +        """Content type header"""                                  
            +        return self.environ.get('CONTENT_TYPE')                    
            +                                                                   
            +    @property                                                      
            +    def content_length(self) -> Optional[int]:                     
            +        """Content length header"""                                
            +        length = self.environ.get('CONTENT_LENGTH')                
            +        return int(length) if length else None                     
            +                                                                   
            +    @property                                                      
            +    def body(self) -> bytes:                                       
            +        """Request body as bytes"""                                
            +        if self._body is None:                                     
            +            wsgi_input = self.environ.get('wsgi.input')            
            +            if wsgi_input:                                         
            +                content_length = self.content_length               
            +                if content_length:                                 
            +                    self._body = wsgi_input.read(content_length)   
            +                else:                                              
            +                    self._body = wsgi_input.read()                 
            +            else:                                                  
            +                self._body = b''                                   
            +        return self._body                                          
            +                                                                   
            +    @property                                                      
            +    def data(self) -> str:                                         
            +        """Request body as string"""                               
            +        return self.body.decode('utf-8', errors='replace')         
            +                                                                   
            +    def get_json(self) -> Any:                                     
            +        """Parse JSON from request body"""                         
            +        if self._json is None and self.content_type and            
            'application/json' in self.content_type:                            
            +            try:                                                   
            +                import json                                        
            +                self._json = json.loads(self.data)                 
            +            except (ValueError, json.JSONDecodeError):             
            +                self._json = None                                  
            +        return self._json                                          
            diff --git a/flaskframework/response.py b/flaskframework/response.py
            new file mode 100644                                                
            index 0000000..870a0d8                                              
            --- /dev/null                                                       
            +++ b/flaskframework/response.py                                    
            @@ -0,0 +1,93 @@                                                    
            +"""                                                                
            +Response object with status code, headers, and body.               
            +"""                                                                
            +                                                                   
            +from typing import Dict, List, Tuple, Union, Optional, Iterator    
            +                                                                   
            +                                                                   
            +class Response:                                                    
            +    """HTTP response object with status code, headers, and body."""
            +                                                                   
            +    def __init__(self, response=None, status=200, headers=None,    
            mimetype='text/html', content_type=None):                           
            +        if isinstance(response, str):                              
            +            self.data = response.encode('utf-8')                   
            +        elif isinstance(response, bytes):                          
            +            self.data = response                                   
            +        elif response is None:                                     
            +            self.data = b''                                        
            +        else:                                                      
            +            # Convert other types to string then bytes             
            +            self.data = str(response).encode('utf-8')              
            +                                                                   
            +        self.status_code = status                                  
            +        self.headers = {}                                          
            +                                                                   
            +        # Set default headers                                      
            +        if headers:                                                
            +            if isinstance(headers, dict):                          
            +                self.headers.update(headers)                       
            +            else:                                                  
            +                # Assume it's a list of tuples                     
            +                for key, value in headers:                         
            +                    self.headers[key] = value                      
            +                                                                   
            +        # Set content type                                         
            +        if content_type:                                           
            +            self.headers['Content-Type'] = content_type            
            +        elif mimetype and 'Content-Type' not in self.headers:      
            +            if mimetype == 'text/html':                            
            +                self.headers['Content-Type'] = 'text/html;         
            charset=utf-8'                                                      
            +            else:                                                  
            +                self.headers['Content-Type'] = mimetype            
            +                                                                   
            +        # Set content length                                       
            +        self.headers['Content-Length'] = str(len(self.data))       
            +                                                                   
            +    @property                                                      
            +    def status(self) -> str:                                       
            +        """Status line for HTTP response"""                        
            +        status_messages = {                                        
            +            200: 'OK',                                             
            +            201: 'Created',                                        
            +            204: 'No Content',                                     
            +            301: 'Moved Permanently',                              
            +            302: 'Found',                                          
            +            304: 'Not Modified',                                   
            +            400: 'Bad Request',                                    
            +            401: 'Unauthorized',                                   
            +            403: 'Forbidden',                                      
            +            404: 'Not Found',                                      
            +            405: 'Method Not Allowed',                             
            +            500: 'Internal Server Error',                          
            +            501: 'Not Implemented',                                
            +            502: 'Bad Gateway',                                    
            +            503: 'Service Unavailable'                             
            +        }                                                          
            +        message = status_messages.get(self.status_code, 'Unknown') 
            +        return f'{self.status_code} {message}'                     
            +                                                                   
            +    def get_wsgi_headers(self) -> List[Tuple[str, str]]:           
            +        """Get headers in WSGI format (list of tuples)"""          
            +        return [(key, str(value)) for key, value in                
            self.headers.items()]                                               
            +                                                                   
            +    def __iter__(self) -> Iterator[bytes]:                         
            +        """Make response iterable for WSGI"""                      
            +        yield self.data                                            
            +                                                                   
            +                                                                   
            +def make_response(rv, status=None, headers=None) -> Response:      
            +    """Convert various return values to Response objects."""       
            +    if isinstance(rv, Response):                                   
            +        if status is not None:                                     
            +            rv.status_code = status                                
            +        if headers:                                                
            +            rv.headers.update(headers)                             
            +        return rv                                                  
            +                                                                   
            +    if isinstance(rv, tuple):                                      
            +        if len(rv) == 2:                                           
            +            rv, status = rv                                        
            +        elif len(rv) == 3:                                         
            +            rv, status, headers = rv                               
            +                                                                   
            +    return Response(rv, status or 200, headers)                    
            diff --git a/flaskframework/routing.py b/flaskframework/routing.py  
            new file mode 100644                                                
            index 0000000..ee8ac1d                                              
            --- /dev/null                                                       
            +++ b/flaskframework/routing.py                                     
            @@ -0,0 +1,140 @@                                                   
            +"""                                                                
            +URL routing with variable segments and HTTP method filtering.      
            +"""                                                                
            +                                                                   
            +import re                                                          
            +from typing import Dict, List, Tuple, Callable, Optional, Any      
            +                                                                   
            +                                                                   
            +class Rule:                                                        
            +    """A URL routing rule with variable segments and method        
            filtering."""                                                       
            +                                                                   
            +    def __init__(self, rule: str, endpoint: str, methods: List[str]
            = None):                                                            
            +        self.rule = rule                                           
            +        self.endpoint = endpoint                                   
            +        self.methods = set(methods or ['GET'])                     
            +                                                                   
            +        # Convert Flask-style route to regex                       
            +        self.regex, self.variables, self.converters =              
            self._compile_rule(rule)                                            
            +                                                                   
            +    def _compile_rule(self, rule: str) -> Tuple[re.Pattern,        
            List[str], Dict[str, str]]:                                         
            +        """Convert a Flask-style route pattern to a regex          
            pattern."""                                                         
            +        variables = []                                             
            +        converters = {}                                            
            +                                                                   
            +        # Find all variable segments like <name> or <int:name>     
            +        def replace_variable(match):                               
            +            full_match = match.group(0)                            
            +            var_spec = match.group(1)                              
            +                                                                   
            +            if ':' in var_spec:                                    
            +                converter, name = var_spec.split(':', 1)           
            +                variables.append(name)                             
            +                converters[name] = converter                       
            +                                                                   
            +                # Different converters                             
            +                if converter == 'int':                             
            +                    return r'(\d+)'                                
            +                elif converter == 'float':                         
            +                    return r'(\d+\.?\d*)'                          
            +                elif converter == 'path':                          
            +                    return r'([^/]+(?:/[^/]+)*)'                   
            +                else:  # string (default)                          
            +                    return r'([^/]+)'                              
            +            else:                                                  
            +                # No converter specified, default to string        
            +                variables.append(var_spec)                         
            +                converters[var_spec] = 'string'                    
            +                return r'([^/]+)'                                  
            +                                                                   
            +        # Replace variable segments                                
            +        pattern = re.sub(r'<([^>]+)>', replace_variable, rule)     
            +                                                                   
            +        # Escape other regex special characters                    
            +        pattern = pattern.replace('.', r'\.')                      
            +                                                                   
            +        # Ensure exact match                                       
            +        pattern = f'^{pattern}$'                                   
            +                                                                   
            +        return re.compile(pattern), variables, converters          
            +                                                                   
            +    def match(self, path: str, method: str) -> Optional[Dict[str,  
            Any]]:                                                              
            +        """Check if this rule matches the given path and method."""
            +        if method not in self.methods:                             
            +            return None                                            
            +                                                                   
            +        match = self.regex.match(path)                             
            +        if not match:                                              
            +            return None                                            
            +                                                                   
            +        # Extract variables and convert to appropriate types       
            +        values = {}                                                
            +        for i, name in enumerate(self.variables):                  
            +            value = match.group(i + 1)                             
            +            converter = self.converters.get(name, 'string')        
            +                                                                   
            +            # Convert to appropriate type                          
            +            if converter == 'int':                                 
            +                try:                                               
            +                    values[name] = int(value)                      
            +                except ValueError:                                 
            +                    return None  # Invalid integer                 
            +            elif converter == 'float':                             
            +                try:                                               
            +                    values[name] = float(value)                    
            +                except ValueError:                                 
            +                    return None  # Invalid float                   
            +            else:  # string or path                                
            +                values[name] = value                               
            +                                                                   
            +        return values                                              
            +                                                                   
            +                                                                   
            +class Map:                                                         
            +    """A collection of URL rules."""                               
            +                                                                   
            +    def __init__(self):                                            
            +        self.rules: List[Rule] = []                                
            +        self.endpoints: Dict[str, Callable] = {}                   
            +                                                                   
            +    def add(self, rule: Rule, view_func: Callable):                
            +        """Add a rule and its associated view function."""         
            +        self.rules.append(rule)                                    
            +        self.endpoints[rule.endpoint] = view_func                  
            +        # Sort rules by specificity (more specific patterns first) 
            +        self._sort_rules()                                         
            +                                                                   
            +    def match(self, path: str, method: str) ->                     
            Tuple[Optional[Callable], Dict[str, Any]]:                          
            +        """Find a matching rule and return the view function and   
            variables."""                                                       
            +        for rule in self.rules:                                    
            +            values = rule.match(path, method)                      
            +            if values is not None:                                 
            +                return self.endpoints[rule.endpoint], values       
            +                                                                   
            +        return None, {}                                            
            +                                                                   
            +    def _sort_rules(self):                                         
            +        """Sort rules by specificity - more specific patterns      
            first."""                                                           
            +        def rule_specificity(rule):                                
            +            # Count the number of specific converters (int, float, 
            path)                                                               
            +            specific_converters = 0                                
            +            generic_converters = 0                                 
            +                                                                   
            +            # Count static parts vs variable parts                 
            +            static_parts = len(rule.rule.split('/')) -             
            len(rule.variables)                                                 
            +                                                                   
            +            for var in rule.variables:                             
            +                # Check if this variable has a specific converter  
            +                if '<int:' in rule.rule or '<float:' in rule.rule  
            or '<path:' in rule.rule:                                           
            +                    specific_converters += 1                       
            +                else:                                              
            +                    generic_converters += 1                        
            +                                                                   
            +            # Rules with more static parts and specific converters 
            come first                                                          
            +            return (-static_parts, -specific_converters,           
            generic_converters)                                                 
            +                                                                   
            +        self.rules.sort(key=rule_specificity)                      
            +                                                                   
            +    def iter_rules(self):                                          
            +        """Iterate over all rules."""                              
            +        return iter(self.rules)                                    
            diff --git a/flaskframework/templating.py                           
            b/flaskframework/templating.py                                      
            new file mode 100644                                                
            index 0000000..8a7375e                                              
            --- /dev/null                                                       
            +++ b/flaskframework/templating.py                                  
            @@ -0,0 +1,109 @@                                                   
            +"""                                                                
            +Jinja2 template rendering integrated with application context.     
            +"""                                                                
            +                                                                   
            +import os                                                          
            +import re                                                          
            +from typing import Dict, Any, Optional                             
            +from .context import current_app, g                                
            +                                                                   
            +                                                                   
            +def _simple_template_render(source: str, **context) -> str:        
            +    """Simple template renderer for when Jinja2 is not             
            available."""                                                       
            +    # Add application context variables                            
            +    template_context = {}                                          
            +    template_context.update(context)                               
            +                                                                   
            +    # Add current_app and g to template context if available       
            +    try:                                                           
            +        template_context['current_app'] = current_app              
            +        template_context['g'] = g                                  
            +    except RuntimeError:                                           
            +        # Outside application context                              
            +        pass                                                       
            +                                                                   
            +    # Simple variable substitution using {{ variable }} syntax     
            +    def replace_var(match):                                        
            +        var_name = match.group(1).strip()                          
            +        # Handle nested attributes like current_app.import_name    
            +        if '.' in var_name:                                        
            +            parts = var_name.split('.')                            
            +            value = template_context.get(parts[0])                 
            +            for part in parts[1:]:                                 
            +                if value is not None:                              
            +                    value = getattr(value, part, None)             
            +        else:                                                      
            +            value = template_context.get(var_name, '')             
            +        return str(value) if value is not None else ''             
            +                                                                   
            +    # Replace {{ variable }} patterns                              
            +    result = re.sub(r'\{\{\s*([^}]+)\s*\}\}', replace_var, source) 
            +    return result                                                  
            +                                                                   
            +                                                                   
            +def render_template_string(source: str, **context) -> str:         
            +    """Render a template from a string."""                         
            +    try:                                                           
            +        from jinja2 import Template                                
            +                                                                   
            +        template = Template(source)                                
            +                                                                   
            +        # Add application context variables                        
            +        template_context = {}                                      
            +        template_context.update(context)                           
            +                                                                   
            +        # Add current_app and g to template context if available   
            +        try:                                                       
            +            template_context['current_app'] = current_app          
            +            template_context['g'] = g                              
            +        except RuntimeError:                                       
            +            # Outside application context                          
            +            pass                                                   
            +                                                                   
            +        return template.render(**template_context)                 
            +                                                                   
            +    except ImportError:                                            
            +        # Fall back to simple template rendering                   
            +        return _simple_template_render(source, **context)          
            +                                                                   
            +                                                                   
            +def render_template(template_name: str, **context) -> str:         
            +    """Render a template from the templates directory."""          
            +    try:                                                           
            +        from jinja2 import Environment, FileSystemLoader           
            +    except ImportError:                                            
            +        raise ImportError("Jinja2 is required for template         
            rendering")                                                         
            +                                                                   
            +    # Get template directory from current app                      
            +    try:                                                           
            +        app = current_app                                          
            +        template_folder = getattr(app, 'template_folder',          
            'templates')                                                        
            +    except RuntimeError:                                           
            +        # Outside application context, use default                 
            +        template_folder = 'templates'                              
            +                                                                   
            +    # Create Jinja2 environment                                    
            +    if os.path.isabs(template_folder):                             
            +        loader = FileSystemLoader(template_folder)                 
            +    else:                                                          
            +        # Relative to current working directory                    
            +        loader = FileSystemLoader(os.path.abspath(template_folder))
            +                                                                   
            +    env = Environment(loader=loader)                               
            +                                                                   
            +    # Load and render template                                     
            +    template = env.get_template(template_name)                     
            +                                                                   
            +    # Add application context variables                            
            +    template_context = {}                                          
            +    template_context.update(context)                               
            +                                                                   
            +    # Add current_app and g to template context if available       
            +    try:                                                           
            +        template_context['current_app'] = current_app              
            +        template_context['g'] = g                                  
            +    except RuntimeError:                                           
            +        # Outside application context                              
            +        pass                                                       
            +                                                                   
            +    return template.render(**template_context)                     
