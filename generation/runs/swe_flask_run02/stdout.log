            11:def _simple_template_render(source: str, **context) -> str:      
            12:    """Simple template renderer for when Jinja2 is not           
            available."""                                                       
            13:    # Add application context variables                          
            14:    template_context = {}                                        
            15:    template_context.update(context)                             
            16:                                                                 
            17:    # Add current_app and g to template context if available     
            18:    try:                                                         
            19:        template_context['current_app'] = current_app            
            20:        template_context['g'] = g                                
            21:    except RuntimeError:                                         
            22:        # Outside application context                            
            23:        pass                                                     
            24:                                                                 
            25:    # Simple variable substitution using {{ variable }} syntax   
            26:    def replace_var(match):                                      
            27:        var_name = match.group(1).strip()                        
            28:        # Handle nested attributes like current_app.import_name  
            29:        if '.' in var_name:                                      
            30:            parts = var_name.split('.')                          
            31:            value = template_context.get(parts[0])               
            32:            for part in parts[1:]:                               
            33:                if value is not None:                            
            34:                    value = getattr(value, part, None)           
            35:        else:                                                    
            36:            value = template_context.get(var_name, '')           
            37:        return str(value) if value is not None else ''           
            38:                                                                 
            39:    # Replace {{ variable }} patterns                            
            40:    result = re.sub(r'\{\{\s*([^}]+)\s*\}\}', replace_var,       
            source)                                                             
            41:    return result                                                
