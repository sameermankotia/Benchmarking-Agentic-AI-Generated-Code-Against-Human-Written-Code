+    return f'User: {name}'
+
+@app.route('/user/<int:user_id>')
+def user_by_id(user_id):
+    return f'User ID: {user_id}'
+
+# Test routing
+environ = {
+    'REQUEST_METHOD': 'GET',
+    'PATH_INFO': '/user/123',
+    'QUERY_STRING': '',
+    'CONTENT_TYPE': '',
+    'CONTENT_LENGTH': '0',
+    'wsgi.input': StringIO(),
+    'wsgi.version': (1, 0),
