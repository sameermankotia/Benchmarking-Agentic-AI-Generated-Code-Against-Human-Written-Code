+    environ = {
+        'REQUEST_METHOD': 'GET',
+        'PATH_INFO': '/template',
+        'QUERY_STRING': '',
+        'wsgi.input': io.BytesIO(b''),
+    }
+    
+    responses = []
+    def start_response(status, headers):
