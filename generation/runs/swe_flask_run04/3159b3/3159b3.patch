+        assert callable(app.run)
+        print("✓ Development server setup test passed")
+    except Exception as e:
+        print(f"✗ Development server test failed: {e}")
+        raise
+
+
+def main():
+    """Run all tests."""
+    print("Running Flask Framework Tests")
+    print("=" * 40)
