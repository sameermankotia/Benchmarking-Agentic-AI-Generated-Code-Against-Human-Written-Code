+
+def test_template_rendering():
+    """Test Jinja2 template rendering."""
+    print("Testing template rendering...")
+    
+    app = Flask(__name__)
+    
+    @app.route('/template')
+    def template_test():
+        return render_template_string('<h1>Hello {{ name }}!</h1>', name='World')
