            +        'CONTENT_TYPE': '',                                        
            +        'CONTENT_LENGTH': '0',                                     
            +        'wsgi.input': io.BytesIO(b''),                             
            +        'HTTP_USER_AGENT': 'Test Agent',                           
            +        'HTTP_ACCEPT': 'text/html',                                
            +    }                                                              
            +                                                                   
            +    responses = []                                                 
