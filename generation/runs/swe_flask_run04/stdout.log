            +                                                                   
            +    for method, path, expected_status, expected_content in         
            test_cases:                                                         
            +        environ = {                                                
            +            'REQUEST_METHOD': method,                              
            +            'PATH_INFO': path,                                     
            +            'QUERY_STRING': '',                                    
            +            'wsgi.input': io.BytesIO(b''),                         
            +        }                                                          
            +                                                                   
            +        responses = []                                             
            +        def start_response(status, headers):                       
            +            responses.append((status, headers))                    
            +                                                                   
            +        result = list(app(environ, start_response))                
            +        status = responses[0][0]                                   
            +        body = b''.join(result)                                    
            +                                                                   
            +        assert status == expected_status, f"Expected               
            {expected_status}, got {status} for {method} {path}"                
            +        assert expected_content in body, f"Expected content not    
            found in {body}"                                                    
            +        print(f"✓ {method} {path} -> {status}")                    
            +                                                                   
            +    print("✓ Blueprint test passed")                               
            +                                                                   
            +                                                                   
            +def test_development_server():                                     
            +    """Test that the development server can be created (without    
            actually running it)."""                                            
            +    print("Testing development server setup...")                   
            +                                                                   
            +    app = Flask(__name__)                                          
            +                                                                   
            +    @app.route('/')                                                
            +    def index():                                                   
            +        return 'Server test'                                       
            +                                                                   
            +    # Just verify the run method exists and can be called with     
            parameters                                                          
            +    # We won't actually start the server                           
            +    try:                                                           
            +        # This should not raise an exception                       
            +        assert hasattr(app, 'run')                                 
            +        assert callable(app.run)                                   
            +        print("✓ Development server setup test passed")            
            +    except Exception as e:                                         
            +        print(f"✗ Development server test failed: {e}")            
            +        raise                                                      
            +                                                                   
            +                                                                   
            +def main():                                                        
            +    """Run all tests."""                                           
            +    print("Running Flask Framework Tests")                         
            +    print("=" * 40)                                                
            +                                                                   
            +    try:                                                           
            +        test_wsgi_compliance()                                     
            +        test_url_routing()                                         
            +        test_request_object()                                      
            +        test_response_object()                                     
            +        test_template_rendering()                                  
            +        test_application_context()                                 
            +        test_blueprints()                                          
            +        test_development_server()                                  
            +                                                                   
            +        print("\n" + "=" * 40)                                     
            +        print("All tests passed! ✓")                               
            +        print("\nThe Flask framework successfully implements:")    
            +        print("1. ✓ URL routing with variable segments and HTTP    
            method filtering")                                                  
            +        print("2. ✓ Request object encapsulating method, path,     
            headers, query string, and body")                                   
            +        print("3. ✓ Response object with status code, headers, and 
            body")                                                              
            +        print("4. ✓ Jinja2 template rendering integrated with      
            application context")                                               
            +        print("5. ✓ Application context management using           
            thread-local storage")                                              
            +        print("6. ✓ Blueprint-based modular applications with URL  
            prefix inheritance")                                                
            +        print("7. ✓ WSGI compliance")                              
            +        print("8. ✓ Built-in development server")                  
            +                                                                   
            +    except Exception as e:                                         
            +        print(f"\n✗ Test failed: {e}")                             
            +        import traceback                                           
            +        traceback.print_exc()                                      
            +        sys.exit(1)                                                
            +                                                                   
            +                                                                   
            +if __name__ == '__main__':                                         
            +    main()                                                         
