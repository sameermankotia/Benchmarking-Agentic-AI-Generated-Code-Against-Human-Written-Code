            +                                                                   
            +        assert status == expected_status, f"Expected               
            {expected_status}, got {status} for {method} {path}"                
            +        assert expected_content in body, f"Expected content not    
            found in {body}"                                                    
            +        print(f"✓ {method} {path} -> {status}")                    
            +                                                                   
            +    print("✓ Blueprint test passed")                               
            +                                                                   
            +                                                                   
            +def test_development_server():                                     
            +    """Test that the development server can be created (without    
            actually running it)."""                                            
            +    print("Testing development server setup...")                   
            +                                                                   
            +    app = Flask(__name__)                                          
            +                                                                   
            +    @app.route('/')                                                
            +    def index():                                                   
