            +    except Exception as e:                                         
            +        print(f"\n✗ Test failed: {e}")                             
            +        import traceback                                           
            +        traceback.print_exc()                                      
            +        sys.exit(1)                                                
            +                                                                   
            +                                                                   
            +if __name__ == '__main__':                                         
            +    main()                                                         
            diff --git a/wsgi_compliance_test.py b/wsgi_compliance_test.py      
