            +    assert responses[0][0] == '200 OK'                             
            +                                                                   
            +    print("✓ Request object test passed")                          
            +                                                                   
            +                                                                   
            +def test_response_object():                                        
            +    """Test response object functionality."""                      
            +    print("Testing response object...")                            
            +                                                                   
            +    app = Flask(__name__)                                          
            +                                                                   
            +    @app.route('/json')                                            
            +    def json_response():                                           
