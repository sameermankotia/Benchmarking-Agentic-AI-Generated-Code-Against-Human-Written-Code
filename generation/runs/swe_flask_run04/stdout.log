            +"""                                                                
            +Response object with status code, headers, and body.               
            +"""                                                                
            +                                                                   
            +from typing import Dict, List, Tuple, Union, Optional, Iterator    
            +                                                                   
            +                                                                   
            +class Response:                                                    
            +    """Response object with status code, headers, and body."""     
            +                                                                   
            +    def __init__(self,                                             
            +                 response: Union[str, bytes, Iterator[bytes]] = '',
            +                 status: int = 200,                                
            +                 headers: Optional[Dict[str, str]] = None,         
            +                 mimetype: str = 'text/html',                      
            +                 content_type: Optional[str] = None):              
            +                                                                   
            +        self.status_code = status                                  
            +        self.headers = headers or {}                               
            +                                                                   
            +        # Set content type                                         
            +        if content_type:                                           
            +            self.headers['Content-Type'] = content_type            
            +        elif 'Content-Type' not in self.headers:                   
            +            self.headers['Content-Type'] = mimetype                
            +                                                                   
            +        # Handle response data                                     
            +        if isinstance(response, str):                              
            +            self.data = response.encode('utf-8')                   
            +        elif isinstance(response, bytes):                          
            +            self.data = response                                   
            +        else:                                                      
            +            # Iterator of bytes                                    
            +            self.data = b''.join(response)                         
            +                                                                   
            +        # Set content length if not already set                    
            +        if 'Content-Length' not in self.headers:                   
            +            self.headers['Content-Length'] = str(len(self.data))   
            +                                                                   
            +    @property                                                      
            +    def status(self) -> str:                                       
            +        """Status line for HTTP response."""                       
            +        status_messages = {                                        
            +            200: 'OK',                                             
            +            201: 'Created',                                        
            +            204: 'No Content',                                     
            +            301: 'Moved Permanently',                              
            +            302: 'Found',                                          
            +            304: 'Not Modified',                                   
            +            400: 'Bad Request',                                    
            +            401: 'Unauthorized',                                   
            +            403: 'Forbidden',                                      
            +            404: 'Not Found',                                      
            +            405: 'Method Not Allowed',                             
            +            500: 'Internal Server Error',                          
            +            501: 'Not Implemented',                                
            +            502: 'Bad Gateway',                                    
            +            503: 'Service Unavailable'                             
            +        }                                                          
            +        message = status_messages.get(self.status_code, 'Unknown') 
            +        return f'{self.status_code} {message}'                     
            +                                                                   
            +    def get_wsgi_headers(self) -> List[Tuple[str, str]]:           
            +        """Get headers in WSGI format (list of tuples)."""         
            +        return [(name, value) for name, value in                   
            self.headers.items()]                                               
            +                                                                   
            +    def set_header(self, name: str, value: str) -> None:           
            +        """Set a response header."""                               
            +        self.headers[name] = value                                 
            +                                                                   
            +    def get_header(self, name: str, default: Optional[str] = None) 
            -> Optional[str]:                                                   
            +        """Get a response header."""                               
            +        return self.headers.get(name, default)                     
            +                                                                   
            +    def __iter__(self) -> Iterator[bytes]:                         
            +        """Make response iterable for WSGI."""                     
            +        yield self.data                                            
            +                                                                   
            +                                                                   
            +def make_response(rv: Union[str, bytes, dict, Response, Tuple]) -> 
            Response:                                                           
            +    """Convert various return values to Response objects."""       
            +    if isinstance(rv, Response):                                   
            +        return rv                                                  
            +                                                                   
            +    if isinstance(rv, dict):                                       
            +        # Convert dictionary to JSON                               
            +        import json                                                
            +        json_str = json.dumps(rv)                                  
            +        return Response(json_str, mimetype='application/json')     
            +                                                                   
            +    if isinstance(rv, tuple):                                      
            +        if len(rv) == 2:                                           
            +            # (response, status) or (response, headers)            
            +            response, second = rv                                  
            +            if isinstance(second, int):                            
            +                # Handle dict response with status                 
            +                if isinstance(response, dict):                     
            +                    import json                                    
            +                    json_str = json.dumps(response)                
            +                    return Response(json_str, status=second,       
            mimetype='application/json')                                        
            +                return Response(response, status=second)           
            +            elif isinstance(second, dict):                         
            +                return Response(response, headers=second)          
            +        elif len(rv) == 3:                                         
            +            # (response, status, headers)                          
            +            response, status, headers = rv                         
            +            if isinstance(response, dict):                         
            +                import json                                        
            +                json_str = json.dumps(response)                    
            +                return Response(json_str, status=status,           
            headers=headers, mimetype='application/json')                       
            +            return Response(response, status=status,               
            headers=headers)                                                    
            +                                                                   
            +    # Default case: string or bytes                                
            +    return Response(rv)                                            
            diff --git a/flaskframework/routing.py b/flaskframework/routing.py  
            new file mode 100644                                                
            index 0000000..e6f9f67                                              
            --- /dev/null                                                       
            +++ b/flaskframework/routing.py                                     
            @@ -0,0 +1,137 @@                                                   
            +"""                                                                
            +URL routing with variable segments and HTTP method filtering.      
            +"""                                                                
            +                                                                   
            +import re                                                          
            +from typing import Dict, List, Tuple, Callable, Optional, Any      
            +                                                                   
            +                                                                   
            +class Rule:                                                        
            +    """A URL routing rule."""                                      
            +                                                                   
            +    def __init__(self, rule: str, endpoint: str, methods: List[str]
            = None):                                                            
            +        self.rule = rule                                           
            +        self.endpoint = endpoint                                   
            +        self.methods = set(methods or ['GET'])                     
            +                                                                   
            +        # Convert Flask-style route to regex                       
            +        self.regex, self.variables = self._compile_rule(rule)      
            +                                                                   
            +    def _compile_rule(self, rule: str) -> Tuple[re.Pattern,        
            List[Tuple[str, str]]]:                                             
            +        """Convert a Flask-style route pattern to a regex          
            pattern."""                                                         
            +        variables = []  # List of (name, converter) tuples         
            +                                                                   
            +        # Find all variable segments like <name> or <int:name>     
            +        def replace_variable(match):                               
            +            full_match = match.group(0)                            
            +            var_spec = match.group(1)                              
            +                                                                   
            +            if ':' in var_spec:                                    
            +                # Type converter specified (e.g., <int:id>)        
            +                converter, name = var_spec.split(':', 1)           
            +                variables.append((name, converter))                
            +                                                                   
            +                if converter == 'int':                             
            +                    return r'(\d+)'                                
            +                elif converter == 'float':                         
            +                    return r'(\d+\.?\d*)'                          
            +                elif converter == 'path':                          
            +                    return r'([^/]+(?:/[^/]+)*)'                   
            +                else:                                              
            +                    # Default to string                            
            +                    return r'([^/]+)'                              
            +            else:                                                  
            +                # No converter specified, default to string        
            +                variables.append((var_spec, 'string'))             
            +                return r'([^/]+)'                                  
            +                                                                   
            +        # Replace variable segments                                
            +        pattern = re.sub(r'<([^>]+)>', replace_variable, rule)     
            +                                                                   
            +        # Escape other regex special characters                    
            +        pattern = pattern.replace('.', r'\.')                      
            +                                                                   
            +        # Ensure exact match                                       
            +        pattern = f'^{pattern}$'                                   
            +                                                                   
            +        return re.compile(pattern), variables                      
            +                                                                   
            +    def match(self, path: str, method: str) -> Optional[Dict[str,  
            Any]]:                                                              
            +        """Check if this rule matches the given path and method."""
            +        if method not in self.methods:                             
            +            return None                                            
            +                                                                   
            +        match = self.regex.match(path)                             
            +        if not match:                                              
            +            return None                                            
            +                                                                   
            +        # Extract variables with type conversion                   
            +        values = {}                                                
            +        for i, (name, converter) in enumerate(self.variables):     
            +            raw_value = match.group(i + 1)                         
            +                                                                   
            +            # Convert value based on converter type                
            +            if converter == 'int':                                 
            +                values[name] = int(raw_value)                      
            +            elif converter == 'float':                             
            +                values[name] = float(raw_value)                    
            +            else:                                                  
            +                values[name] = raw_value                           
            +                                                                   
            +        return values                                              
            +                                                                   
            +                                                                   
            +class Map:                                                         
            +    """URL map containing routing rules."""                        
            +                                                                   
            +    def __init__(self):                                            
            +        self.rules: List[Rule] = []                                
            +        self.endpoints: Dict[str, Callable] = {}                   
            +                                                                   
            +    def add(self, rule: Rule, view_func: Callable):                
            +        """Add a routing rule."""                                  
            +        self.rules.append(rule)                                    
            +        self.endpoints[rule.endpoint] = view_func                  
            +        # Sort rules so more specific ones (with type converters)  
            come first                                                          
            +        self._sort_rules()                                         
            +                                                                   
            +    def _sort_rules(self):                                         
            +        """Sort rules by specificity - more specific rules         
            first."""                                                           
            +        def rule_specificity(rule):                                
            +            # Count non-string converters (more specific)          
            +            non_string_converters = sum(1 for name, converter in   
            rule.variables if converter != 'string')                            
            +            # Count total variables (fewer variables = more        
            specific for same converter count)                                  
            +            total_variables = len(rule.variables)                  
            +            # Static parts count (more static parts = more         
            specific)                                                           
            +            static_parts = len([part for part in                   
            rule.rule.split('/') if not part.startswith('<')])                  
            +                                                                   
            +            # Return tuple for sorting: (non_string_converters     
            desc, static_parts desc, total_variables asc)                       
            +            return (-non_string_converters, -static_parts,         
            total_variables)                                                    
            +                                                                   
            +        self.rules.sort(key=rule_specificity)                      
            +                                                                   
            +    def match(self, path: str, method: str) ->                     
            Tuple[Optional[Callable], Dict[str, Any]]:                          
            +        """Find a matching rule for the given path and method."""  
            +        for rule in self.rules:                                    
            +            values = rule.match(path, method)                      
            +            if values is not None:                                 
            +                view_func = self.endpoints.get(rule.endpoint)      
            +                return view_func, values                           
            +                                                                   
            +        return None, {}                                            
            +                                                                   
            +                                                                   
            +class Router:                                                      
            +    """URL router for the application."""                          
            +                                                                   
            +    def __init__(self):                                            
            +        self.url_map = Map()                                       
            +                                                                   
            +    def add_url_rule(self, rule: str, endpoint: str, view_func:    
            Callable, methods: List[str] = None):                               
            +        """Add a URL rule to the router."""                        
            +        rule_obj = Rule(rule, endpoint, methods)                   
            +        self.url_map.add(rule_obj, view_func)                      
            +                                                                   
            +    def match(self, path: str, method: str) ->                     
            Tuple[Optional[Callable], Dict[str, Any]]:                          
            +        """Match a request to a view function."""                  
            +        return self.url_map.match(path, method)                    
            diff --git a/flaskframework/templating.py                           
            b/flaskframework/templating.py                                      
            new file mode 100644                                                
            index 0000000..eebf5c0                                              
            --- /dev/null                                                       
            +++ b/flaskframework/templating.py                                  
            @@ -0,0 +1,61 @@                                                    
            +"""                                                                
            +Jinja2 template rendering integrated with the application context. 
            +"""                                                                
            +                                                                   
            +import os                                                          
            +from typing import Dict, Any, Optional                             
            +                                                                   
            +try:                                                               
            +    from jinja2 import Environment, FileSystemLoader,              
            select_autoescape                                                   
            +    HAS_JINJA2 = True                                              
            +except ImportError:                                                
            +    HAS_JINJA2 = False                                             
            +                                                                   
            +                                                                   
            +class TemplateEngine:                                              
            +    """Template engine for rendering Jinja2 templates."""          
            +                                                                   
            +    def __init__(self, template_folder: str = 'templates'):        
            +        self.template_folder = template_folder                     
            +        self._environment = None                                   
            +                                                                   
            +    @property                                                      
            +    def environment(self):                                         
            +        """Get or create the Jinja2 environment."""                
            +        if self._environment is None:                              
            +            if not HAS_JINJA2:                                     
            +                raise RuntimeError("Jinja2 is required for template
            rendering")                                                         
            +                                                                   
            +            # Create template directory if it doesn't exist        
            +            if not os.path.exists(self.template_folder):           
            +                os.makedirs(self.template_folder)                  
            +                                                                   
            +            loader = FileSystemLoader(self.template_folder)        
            +            self._environment = Environment(                       
            +                loader=loader,                                     
            +                autoescape=select_autoescape(['html', 'xml'])      
            +            )                                                      
            +                                                                   
            +        return self._environment                                   
            +                                                                   
            +    def render_template(self, template_name: str, **context) ->    
            str:                                                                
            +        """Render a template with the given context."""            
            +        template = self.environment.get_template(template_name)    
            +        return template.render(**context)                          
            +                                                                   
            +    def render_template_string(self, source: str, **context) ->    
            str:                                                                
            +        """Render a template from a string."""                     
            +        template = self.environment.from_string(source)            
            +        return template.render(**context)                          
            +                                                                   
            +                                                                   
            +def render_template(template_name: str, **context) -> str:         
            +    """Render a template using the current app's template          
            engine."""                                                          
            +    from .context import current_app                               
            +    return                                                         
            current_app.template_engine.render_template(template_name,          
            **context)                                                          
            +                                                                   
            +                                                                   
            +def render_template_string(source: str, **context) -> str:         
            +    """Render a template string using the current app's template   
            engine."""                                                          
            +    from .context import current_app                               
            +    return                                                         
            current_app.template_engine.render_template_string(source,          
            **context)                                                          
