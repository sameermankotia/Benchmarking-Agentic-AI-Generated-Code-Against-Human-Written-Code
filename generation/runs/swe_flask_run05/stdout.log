                with app.app_context():                                         
                    assert current_app == app, "current_app should be available 
            in context"                                                         
                    g.test_value = '"'"'test'"'"'                               
                    assert g.test_value == '"'"'test'"'"', "g should store      
            values"                                                             
                                                                                
                # Test that context is cleaned up                               
                try:                                                            
                    _ = current_app                                             
                    assert False, "current_app should not be available outside  
            context"                                                            
                except RuntimeError:                                            
                    pass  # Expected                                            
                                                                                
                print("✓ Application context works")                            
                                                                                
                                                                                
            def test_blueprints():                                              
