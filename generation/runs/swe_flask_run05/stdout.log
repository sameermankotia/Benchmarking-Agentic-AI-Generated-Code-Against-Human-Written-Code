                print("Testing Blueprints...")                                  
                                                                                
                app = Flask(__name__)                                           
                                                                                
                # Create blueprint                                              
                api = Blueprint('"'"'api'"'"', __name__,                        
            url_prefix='"'"'/api'"'"')                                          
                                                                                
                @api.route('"'"'/users'"'"')                                    
                def list_users():                                               
                    return '"'"'Users list'"'"'                                 
                                                                                
                @api.route('"'"'/users/<int:id>'"'"')                           
                def get_user(id):                                               
                    return f'"'"'User {id}'"'"'                                 
                                                                                
                # Register blueprint                                            
                app.register_blueprint(api)                                     
                                                                                
