            '"'"'GET'"'"')                                                      
                assert view_func is not None, "Should match blueprint route"    
                                                                                
                view_func, args = app.match_request('"'"'/api/users/123'"'"',   
            '"'"'GET'"'"')                                                      
                assert view_func is not None, "Should match blueprint route with
            variable"                                                           
                assert args == {'"'"'id'"'"': '"'"'123'"'"'}, f"Expected id=123,
            got {args}"                                                         
                                                                                
                print("✓ Blueprints work")                                      
                                                                                
                                                                                
            def test_template_rendering():                                      
