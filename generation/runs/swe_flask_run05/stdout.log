                assert response.status_code == 200, "Default status should be   
            200"                                                                
                assert response.data == b'"'"'Hello World'"'"', "Data should be 
            encoded"                                                            
                                                                                
                # Test custom status and headers                                
                response = Response('"'"'Not Found'"'"', status=404,            
            headers={'"'"'Custom'"'"': '"'"'Header'"'"'})                       
                assert response.status_code == 404, "Status should be 404"      
                assert response.headers['"'"'Custom'"'"'] == '"'"'Header'"'"',  
            "Custom header should be set"                                       
                assert response.status == '"'"'404 Not Found'"'"', "Status line 
            should be formatted"                                                
                                                                                
                # Test WSGI headers                                             
                wsgi_headers = response.get_wsgi_headers()                      
                header_dict = dict(wsgi_headers)                                
                assert '"'"'Content-Length'"'"' in header_dict, "Should include 
            Content-Length"                                                     
                assert '"'"'Custom'"'"' in header_dict, "Should include custom  
            headers"                                                            
                                                                                
                print("✓ Response object works")                                
                                                                                
                                                                                
            def test_application_context():                                     
                """Test application context management."""                      
                print("Testing application context...")                         
                                                                                
                app = Flask(__name__)                                           
                                                                                
